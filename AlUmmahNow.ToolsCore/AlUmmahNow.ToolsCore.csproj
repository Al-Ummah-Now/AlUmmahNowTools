<Project Sdk="Microsoft.NET.Sdk">
  <!-- Al Ummah Now Tools without UI: environments, sign-in on aun-core's AuthManager, token stores,
       the staff check against admin-api and the app's preferences. Tested in AlUmmahNow.ToolsCore.Tests. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- CI's update test only (.github/workflows/update-test.yml): the root key and the server come from the environment.
       Never in a release: release.yml refuses it. -->
  <PropertyGroup Condition="'$(UpdateTest)' == 'true'">
    <DefineConstants>$(DefineConstants);UPDATE_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fetched and checksum-verified by scripts/fetch-core.sh into .nuget-local (nuget.config) -->
    <PackageReference Include="AlUmmahNow.Core" Version="0.4.0-rc.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <InternalsVisibleTo Include="AlUmmahNow.ToolsCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The root-signed update key list, byte for byte (its signature covers the exact bytes; .gitattributes) -->
    <EmbeddedResource Include="Updates/keys/update-keys.json" LogicalName="update-keys.json" />
    <EmbeddedResource Include="Updates/keys/update-keys.json.sig" LogicalName="update-keys.json.sig" />
  </ItemGroup>
</Project>
