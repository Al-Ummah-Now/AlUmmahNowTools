<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AlUmmahNow.VisualImporter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporter"
    xmlns:views="using:AlUmmahNow.VisualImporter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AlUmmah Now - Video Importer"
    Closed="Window_Closed">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navigation Structure -->
        <NavigationView x:Name="NavView" 
                       Grid.Row="0"
                       IsPaneToggleButtonVisible="True"
                       IsBackButtonVisible="Collapsed"
                       SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" IsSelected="True"/>
                <NavigationViewItem Content="Import" Tag="Import" Icon="Upload"/>
                <NavigationViewItem Content="Service Status" Tag="ServiceStatus" Icon="Sync"/>
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed"/>
        </NavigationView>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/logo.png" Width="16" Height="16" Margin="0,0,10,0"/>
                <TextBlock x:Name="StatusBarTextBlock" Text="Ready"
                           Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
