<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporter.Views.FileDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporter.Views"
    xmlns:models="using:AlUmmahNow.VisualImporter.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder Selection -->
        <StackPanel Grid.Row="0" Margin="20" Spacing="10">
            <TextBlock Text="Video Import Manager" Style="{ThemeResource TitleTextBlockStyle}"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" 
                         PlaceholderText="Select a folder containing video files..."
                         Text="{x:Bind ViewModel.SelectedFolderPath, Mode=TwoWay}"
                         IsReadOnly="True"/>
                
                <Button Grid.Column="1" 
                        Content="Browse..."
                        Command="{x:Bind ViewModel.SelectFolderCommand}"
                        Margin="10,0,0,0"/>
                
                <Button Grid.Column="2" 
                        Content="Scan Folder"
                        Command="{x:Bind ViewModel.ScanFolderCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- File Statistics and Controls -->
        <Grid Grid.Row="1" Margin="20,0,20,10" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Statistics -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{x:Bind ViewModel.FileStatistics.TotalFiles, Mode=OneWay, FallbackValue='0'}" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="files" Style="{ThemeResource BodyTextBlockStyle}"/>
                
                <TextBlock Text="|" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                
                <TextBlock Text="{x:Bind ViewModel.FileStatistics.TotalSizeFormatted, Mode=OneWay, FallbackValue='0 B'}" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                
                <TextBlock Text="|" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                
                <TextBlock Text="{x:Bind ViewModel.FileStatistics.DuplicateFiles, Mode=OneWay, FallbackValue='0'}" 
                           Style="{ThemeResource SubtitleTextBlockStyle}" 
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="duplicates" Style="{ThemeResource BodyTextBlockStyle}"/>
            </StackPanel>

            <!-- Filter Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ComboBox Header="Sort by" 
                          SelectedIndex="0"
                          MinWidth="120">
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Size"/>
                    <ComboBoxItem Content="Date Created"/>
                    <ComboBoxItem Content="Date Modified"/>
                    <ComboBoxItem Content="Directory"/>
                </ComboBox>
                
                <Button Content="?" 
                        Command="{x:Bind ViewModel.ToggleSortDirectionCommand}"
                        ToolTipService.ToolTip="Toggle sort direction"/>
                
                <ComboBox Header="Channel" 
                          ItemsSource="{x:Bind ViewModel.AvailableChannels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.ChannelFilter, Mode=TwoWay}"
                          MinWidth="150"/>
            </StackPanel>
        </Grid>

        <!-- Video Files List -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,10" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Options -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                    <CheckBox Content="Hide duplicates" 
                              IsChecked="{x:Bind ViewModel.HideDuplicates, Mode=TwoWay}"/>
                    <CheckBox Content="Show only selected" 
                              IsChecked="{x:Bind ViewModel.ShowOnlySelected, Mode=TwoWay}"/>
                    <Button Content="Select All" 
                            Command="{x:Bind ViewModel.SelectAllFilesCommand}"
                            Style="{ThemeResource DefaultButtonStyle}"/>
                    <Button Content="Deselect All" 
                            Command="{x:Bind ViewModel.DeselectAllFilesCommand}"/>
                </StackPanel>

                <!-- Files List -->
                <ListView Grid.Row="1" 
                          ItemsSource="{x:Bind ViewModel.FilteredVideoFiles, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedVideoFile, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoFileInfo">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind IsDuplicate, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>

                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{x:Bind FileName}" 
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind RelativePath}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind FileSizeFormatted}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="10,0"/>

                                <TextBlock Grid.Column="3" 
                                           Text="{x:Bind StatusText}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           Margin="10,0"/>

                                <FontIcon Grid.Column="4" 
                                          Glyph="&#xE7C3;" 
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind IsDuplicate, Mode=OneWay}"
                                          ToolTipService.ToolTip="Duplicate file"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="20" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Progress and Status -->
            <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Style="{ThemeResource BodyTextBlockStyle}"/>
                <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" 
                             Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}"/>
            </StackPanel>

            <!-- Import Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Import Selected Files" 
                        Command="{x:Bind ViewModel.StartImportCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanStartImport, Mode=OneWay}"/>
                
                <Button Content="Import Entire Folder" 
                        Command="{x:Bind ViewModel.StartImportFromFolderCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartImport, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.RowSpan="4" 
              Background="{ThemeResource SystemControlAcrylicWindowBrush}"
              Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Scanning for video files..." 
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>