<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporter.Views.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporter.Views"
    xmlns:vm="using:AlUmmahNow.VisualImporter.ViewModels"
    xmlns:converters="using:AlUmmahNow.VisualImporter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter"/>
        <converters:CountComparisonToVisibilityConverter x:Key="CountComparisonToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel>
                <!-- App Header with Back Button -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BackToDashboardButton" 
                            Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" 
                            Style="{ThemeResource DefaultButtonStyle}"
                            Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="Back to Dashboard"
                            Click="BackToDashboardButton_Click" 
                            Margin="0,0,16,0"/>
                    <Image Source="/Assets/logo.png" Width="32" Height="32" Margin="0,0,10,0"/>
                    <TextBlock Text="Video Import" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Folder Selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Import Folder:" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="100"/>
                    <TextBox x:Name="FolderPathTextBox" 
                             Text="{x:Bind ViewModel.SelectedFolderPath, Mode=TwoWay}"
                             Width="300" Margin="0,0,10,0"/>
                    <Button x:Name="BrowseButton" Content="Browse..." 
                            Command="{x:Bind ViewModel.SelectFolderCommand}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="ScanButton" Content="Scan Folder" 
                            Command="{x:Bind ViewModel.ScanFolderCommand}"
                            Margin="0,0,10,0"
                            Style="{ThemeResource DefaultButtonStyle}"/>
                    <Button x:Name="StartImportButton" Content="Start Import" 
                            Command="{x:Bind ViewModel.StartImportCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" 
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
                    <ProgressBar x:Name="ImportProgressBar" 
                                 Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" 
                                 Maximum="100" Height="6" Margin="0,5"/>
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                               Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Simplified Main Content for now -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel>
                <TextBlock Text="Import Functionality" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,16"/>
                <TextBlock Text="This page will contain the import functionality. Use the navigation to explore other parts of the application." 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="• Select a folder to scan for video files" 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="• Configure import settings" 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="• Monitor import progress" 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>