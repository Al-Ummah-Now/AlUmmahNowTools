<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporter.Views.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporter.Views"
    xmlns:vm="using:AlUmmahNow.VisualImporter.ViewModels"
    xmlns:models="using:AlUmmahNow.VisualImporter.Models"
    xmlns:converters="using:AlUmmahNow.VisualImporter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter"/>
        <converters:CountComparisonToVisibilityConverter x:Key="CountComparisonToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Import Videos" Style="{ThemeResource TitleTextBlockStyle}"/>

                    <!-- Import Button - Always visible when files are scanned -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileCount, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="files selected"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Button Content="Import Selected"
                                Command="{x:Bind ViewModel.StartImportCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.HasSelectedFiles, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <!-- Database Status -->
                <Border Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Visibility="{x:Bind ViewModel.HasDatabaseStats, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" Margin="0,0,12,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind ViewModel.DatabaseStatusMessage, Mode=OneWay, FallbackValue='Loading database status...'}"
                                       FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Folder Selection -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             PlaceholderText="Select a folder containing video files..."
                             Text="{x:Bind ViewModel.SelectedFolderPath, Mode=TwoWay}"
                             IsReadOnly="True"
                             Margin="0,0,12,0"/>

                    <Button Grid.Column="1"
                            Content="Browse"
                            Command="{x:Bind ViewModel.SelectFolderCommand}"
                            Margin="0,0,12,0"/>

                    <Button Grid.Column="2"
                            Content="Scan Folder"
                            Command="{x:Bind ViewModel.ScanFolderCommand}"
                            Style="{ThemeResource AccentButtonStyle}"/>
                </Grid>

                <!-- Progress -->
                <StackPanel Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Spacing="8">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}"
                                 Maximum="100" Height="6"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

                <!-- Import Progress -->
                <StackPanel Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <Grid Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Statistics & Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File Statistics -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.FileStatistics.TotalFiles, Mode=OneWay, FallbackValue='0'}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="files found" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center"/>

                        <TextBlock Text="|" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>

                        <TextBlock Text="{x:Bind ViewModel.FileStatistics.TotalSizeFormatted, Mode=OneWay, FallbackValue='0 B'}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    </StackPanel>

                    <!-- Filter Options -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Select All"
                                Command="{x:Bind ViewModel.SelectAllFilesCommand}"/>
                        <Button Content="Deselect All"
                                Command="{x:Bind ViewModel.DeselectAllFilesCommand}"/>
                        <CheckBox Content="Show only selected"
                                  IsChecked="{x:Bind ViewModel.ShowOnlySelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Files List -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.FilteredVideoFiles, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedVideoFile, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoFileInfo">
                            <Grid Margin="0,8" Padding="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Margin="0,0,16,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind RelativePath}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FileSizeFormatted}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Grid Grid.RowSpan="2"
              Background="{ThemeResource SystemControlAcrylicWindowBrush}"
              Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Scanning for video files..."
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>