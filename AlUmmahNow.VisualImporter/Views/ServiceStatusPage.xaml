<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporter.Views.ServiceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:AlUmmahNow.VisualImporter.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Service Status Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                       Text="FileScan Service Status" 
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,16"/>

            <!-- Status Card -->
            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Ellipse Grid.Column="0" 
                             Width="20" 
                             Height="20" 
                             Margin="0,0,16,0"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind ViewModel.ServiceStatusColor, Mode=OneWay, Converter={StaticResource ColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" 
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock Text="{x:Bind ViewModel.ServiceStatusMessage, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Connect/Disconnect Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" 
                                Command="{x:Bind ViewModel.ConnectToServiceCommand}"
                                IsEnabled="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource AccentButtonStyle}">
                            <Button.Visibility>
                                <Binding Path="ServiceStatus" Converter="{StaticResource ServiceStatusToVisibilityConverter}">
                                    <Binding.ConverterParameter>Disconnected,NotAvailable,Stopped</Binding.ConverterParameter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Disconnect" 
                                Command="{x:Bind ViewModel.DisconnectFromServiceCommand}">
                            <Button.Visibility>
                                <Binding Path="ServiceStatus" Converter="{StaticResource ServiceStatusToVisibilityConverter}">
                                    <Binding.ConverterParameter>Connected,Reconnecting</Binding.ConverterParameter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" 
                                      Width="24" 
                                      Height="24"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Ongoing Operations Section -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Ongoing Operations" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    MinHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <StackPanel>
                        <!-- No operations message -->
                        <TextBlock Text="No active operations" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,20">
                            <TextBlock.Visibility>
                                <Binding Path="HasActiveOperation" Converter="{StaticResource InverseBoolToVisibilityConverter}"/>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- Operations List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OngoingOperations, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:OperationInfo">
                                    <Border Margin="0,0,0,12" 
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Operation Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{x:Bind DisplayText, Mode=OneWay}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{x:Bind Duration, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Grid.Row="1" 
                                                         Value="{x:Bind Progress, Mode=OneWay}"
                                                         Maximum="100"
                                                         Margin="0,0,0,4"/>

                                            <!-- Details -->
                                            <TextBlock Grid.Row="2" 
                                                       Text="{x:Bind ItemsProcessed, Mode=OneWay, Converter={StaticResource ItemsProcessedConverter}}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Errors Section -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Error Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Errors" 
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Button Grid.Column="1" 
                        Content="Clear" 
                        Command="{x:Bind ViewModel.ClearErrorsCommand}"
                        IsEnabled="{x:Bind ViewModel.Errors.Count, Mode=OneWay, Converter={StaticResource CountToBoolConverter}}"/>
            </Grid>

            <!-- Errors List -->
            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- No errors message -->
                        <TextBlock Text="No errors" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12">
                            <TextBlock.Visibility>
                                <Binding Path="Errors.Count" Converter="{StaticResource CountComparisonToVisibilityConverter}">
                                    <Binding.ConverterParameter>0</Binding.ConverterParameter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- Errors List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ErrorMessage">
                                    <Border Margin="0,0,0,8" 
                                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <TextBlock Text="{x:Bind DisplayText}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
