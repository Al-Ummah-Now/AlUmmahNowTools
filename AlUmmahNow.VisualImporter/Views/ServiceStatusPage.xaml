<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporter.Views.ServiceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:AlUmmahNow.VisualImporter.ViewModels"
    xmlns:converters="using:AlUmmahNow.VisualImporter.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:ColorConverter x:Key="ColorConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:ItemsProcessedConverter x:Key="ItemsProcessedConverter"/>
        <converters:CountToBoolConverter x:Key="CountToBoolConverter"/>
        <converters:CountComparisonToVisibilityConverter x:Key="CountComparisonToVisibilityConverter"/>
        <converters:MessageTypeToColorConverter x:Key="MessageTypeToColorConverter"/>
        <converters:MessageTypeToBorderColorConverter x:Key="MessageTypeToBorderColorConverter"/>
        <converters:ServiceStatusToVisibilityConverter x:Key="ServiceStatusToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Service Status Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" 
                       Text="FileScan Service Status" 
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,16"/>

            <!-- Status Card -->
            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Ellipse Grid.Column="0" 
                             Width="20" 
                             Height="20" 
                             Margin="0,0,16,0"
                             VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{x:Bind ViewModel.ServiceStatusColor, Mode=OneWay, Converter={StaticResource ColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Status Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" 
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock Text="{x:Bind ViewModel.ServiceStatusMessage, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{x:Bind ViewModel.ServiceHealthMessage, Mode=OneWay}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Connect/Disconnect Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Connect" 
                                Command="{x:Bind ViewModel.ConnectToServiceCommand}"
                                IsEnabled="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource AccentButtonStyle}">
                            <Button.Visibility>
                                <Binding Path="ServiceStatus" Converter="{StaticResource ServiceStatusToVisibilityConverter}">
                                    <Binding.ConverterParameter>Disconnected,NotAvailable,Stopped</Binding.ConverterParameter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                        <Button Content="Disconnect" 
                                Command="{x:Bind ViewModel.DisconnectFromServiceCommand}">
                            <Button.Visibility>
                                <Binding Path="ServiceStatus" Converter="{StaticResource ServiceStatusToVisibilityConverter}">
                                    <Binding.ConverterParameter>Connected,Reconnecting</Binding.ConverterParameter>
                                </Binding>
                            </Button.Visibility>
                        </Button>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" 
                                      Width="24" 
                                      Height="24"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Service Management Section -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Service Management" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12"/>

            <!-- Quick Actions Panel -->
            <Border Grid.Row="1"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Service Control"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Start and manage the background service"
                                   FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Start Service"
                            Command="{x:Bind ViewModel.StartServiceCommand}"
                            IsEnabled="{x:Bind ViewModel.CanStartService, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                        <Button.Visibility>
                            <Binding Path="IsStartingService" Converter="{StaticResource InverseBoolToVisibilityConverter}"/>
                        </Button.Visibility>
                    </Button>
                </Grid>
            </Border>

            <!-- Service Management Actions -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Messages -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Service Actions"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <!-- Loading indicators -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.IsStartingService, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="20" Height="20"/>
                            <TextBlock Text="Starting service..."
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.IsStoppingService, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="20" Height="20"/>
                            <TextBlock Text="Stopping service..."
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Management Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Stop Service"
                                Command="{x:Bind ViewModel.StopServiceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanStopService, Mode=OneWay}">
                            <Button.Visibility>
                                <Binding Path="IsStoppingService" Converter="{StaticResource InverseBoolToVisibilityConverter}"/>
                            </Button.Visibility>
                        </Button>

                        <Button Content="Refresh"
                                Command="{x:Bind ViewModel.RefreshStatusCommand}"
                                ToolTipService.ToolTip="Refresh service status"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Ongoing Operations Section -->
        <Grid Grid.Row="2" Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Ongoing Operations" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    MinHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <StackPanel>
                        <!-- No operations message -->
                        <TextBlock Text="No active operations" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,20,0,20">
                            <TextBlock.Visibility>
                                <Binding Path="HasActiveOperation" Converter="{StaticResource InverseBoolToVisibilityConverter}"/>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- Operations List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OngoingOperations, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:OperationInfo">
                                    <Border Margin="0,0,0,12" 
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Operation Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{x:Bind DisplayText, Mode=OneWay}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{x:Bind Duration, Mode=OneWay}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Grid.Row="1" 
                                                         Value="{x:Bind Progress, Mode=OneWay}"
                                                         Maximum="100"
                                                         Margin="0,0,0,4"/>

                                            <!-- Details -->
                                            <TextBlock Grid.Row="2" 
                                                       Text="{x:Bind ItemsProcessed, Mode=OneWay, Converter={StaticResource ItemsProcessedConverter}}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Errors Section -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Messages Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Messages"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Button Grid.Column="1"
                        Content="Clear"
                        Command="{x:Bind ViewModel.ClearErrorsCommand}"
                        IsEnabled="{x:Bind ViewModel.Errors.Count, Mode=OneWay, Converter={StaticResource CountToBoolConverter}}"/>
            </Grid>

            <!-- Errors List -->
            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- No errors message -->
                        <TextBlock Text="No messages" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12">
                            <TextBlock.Visibility>
                                <Binding Path="Errors.Count" Converter="{StaticResource CountComparisonToVisibilityConverter}">
                                    <Binding.ConverterParameter>0</Binding.ConverterParameter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- Errors List -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Errors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:ErrorMessage">
                                    <Border Margin="0,0,0,8" 
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <Border.Background>
                                            <SolidColorBrush>
                                                <SolidColorBrush.Color>
                                                    <Binding Path="Type" Converter="{StaticResource MessageTypeToColorConverter}"/>
                                                </SolidColorBrush.Color>
                                            </SolidColorBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush>
                                                <SolidColorBrush.Color>
                                                    <Binding Path="Type" Converter="{StaticResource MessageTypeToBorderColorConverter}"/>
                                                </SolidColorBrush.Color>
                                            </SolidColorBrush>
                                        </Border.BorderBrush>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind TypeIcon}" 
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,8,0"
                                                       FontSize="14"/>
                                            
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DisplayText}" 
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
