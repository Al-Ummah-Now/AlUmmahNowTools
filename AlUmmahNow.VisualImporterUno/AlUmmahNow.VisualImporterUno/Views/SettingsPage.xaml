<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <!-- Service Configuration -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Service Configuration"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- Service URL -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Service URL" FontWeight="SemiBold"/>
                            <TextBox x:Name="ServiceUrlTextBox"
                                     Text="{x:Bind ViewModel.FileScanServiceUrl, Mode=TwoWay}"
                                     PlaceholderText="http://localhost:5000"
                                     HorizontalAlignment="Left"
                                     Width="400"/>
                            <TextBlock Text="The HTTP endpoint where the FileScan service runs"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Test Connection -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test Connection"
                                    Click="TestConnectionButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsTesting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}"
                                          Width="20"
                                          Height="20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Service Management -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Service Management"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- Auto Start Service -->
                        <StackPanel Spacing="8">
                            <CheckBox Content="Automatically start FileScan service"
                                      IsChecked="{x:Bind ViewModel.AutoStartService, Mode=TwoWay}"/>
                            <TextBlock Text="Start the FileScan service automatically when the application launches"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Service Executable Path -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Service Executable Path" FontWeight="SemiBold"/>
                            <TextBox x:Name="ServicePathTextBox"
                                     Text="{x:Bind ViewModel.ServiceExecutablePath, Mode=TwoWay}"
                                     PlaceholderText="Path to AlUmmahNow.FileScanService.exe"
                                     HorizontalAlignment="Left"
                                     Width="400"/>
                            <TextBlock Text="Full path to the FileScan service executable"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Browse for Service -->
                        <Button Content="Browse for Service Executable"
                                Click="BrowseServiceButton_Click"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Database Configuration -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Database Configuration"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- Database Connection String -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Database Connection String" FontWeight="SemiBold"/>
                            <TextBox x:Name="DatabaseConnectionTextBox"
                                     Text="{x:Bind ViewModel.DatabaseConnectionString, Mode=TwoWay}"
                                     PlaceholderText="Server=(localdb)\MSSQLLocalDB;Database=AlUmmahNowFileScan;Trusted_Connection=true"
                                     HorizontalAlignment="Left"
                                     Width="500"/>
                            <TextBlock Text="SQL Server connection string for the import database"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Save Settings"
                            Click="SaveSettingsButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Reset to Defaults"
                            Click="ResetDefaultsButton_Click"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                  Width="20"
                                  Height="20"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>