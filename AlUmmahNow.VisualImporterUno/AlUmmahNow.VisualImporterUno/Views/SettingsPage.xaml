<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Folder scanner: where it listens -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_ScannerTitle" Text="Folder scanner" Style="{StaticResource ToolsCardTitle}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_AddressLabel" Text="Address" Style="{StaticResource ToolsLabel}" />
                        <TextBox x:Uid="Settings_AddressBox" PlaceholderText="http://localhost:5000" FlowDirection="LeftToRight"
                                 Text="{x:Bind ViewModel.FileScanServiceUrl, Mode=TwoWay}" />
                        <TextBlock x:Uid="Settings_AddressHint" Text="Where Tools reaches the scanner on this computer. Leave it as it is unless support asks you to change it." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsSecondaryButton}" Click="TestConnectionButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsTesting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsTesting, Mode=OneWay}" />
                                <TextBlock x:Uid="Settings_Test" Text="Test connection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.TestResults, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                </StackPanel>
            </Border>

            <!-- Folder scanner: the program itself -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Settings_ProgramTitle" Text="Scanner program" Style="{StaticResource ToolsCardTitle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Settings_AutoStart" Text="Turn the scanner on when Tools opens" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                            <TextBlock x:Uid="Settings_AutoStartHint" Text="Watched folders are only checked while the scanner is on." Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoStartService, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_PathLabel" Text="Program location" Style="{StaticResource ToolsLabel}" />
                        <TextBox x:Uid="Settings_PathBox" PlaceholderText="Found automatically" FlowDirection="LeftToRight"
                                 Text="{x:Bind ViewModel.ServiceExecutablePath, Mode=TwoWay}" />
                        <TextBlock x:Uid="Settings_PathHint" Text="Tools looks beside itself first. Choose a file only if the scanner was installed somewhere else." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                    <Button Style="{StaticResource ToolsSecondaryButton}" Click="BrowseServiceButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock x:Uid="Settings_Browse" Text="Choose file" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Settings_NotificationsTitle" Text="Notifications" Style="{StaticResource ToolsCardTitle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Settings_Notify" Text="Tell me when videos arrive" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                            <TextBlock x:Uid="Settings_NotifyHint" Text="A desktop notification when a watched folder gets a new video or an approval is made." Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableNotifications, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Settings_Sound" Text="Play a sound" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                            <TextBlock x:Uid="Settings_SoundHint" Text="With each notification." Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableNotificationSound, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableNotifications, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Style="{StaticResource ToolsPrimaryButton}" Click="SaveSettingsButton_Click"
                            IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                            <TextBlock x:Uid="Settings_Save" Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolsSecondaryButton}" Click="ResetDefaultsButton_Click">
                        <TextBlock x:Uid="Settings_Reset" Text="Restore defaults" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SaveStatus" Style="{StaticResource ToolsMuted}" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
