<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.SocialSourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:core="using:AlUmmahNow.ToolsCore.Import"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Spacing="16" Padding="24,8,24,24" MaxWidth="1200">

            <!-- Not a super admin: the page says so (admin-api refuses every source call too) -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.IsNotSuperAdmin}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Social_SuperAdminTitle" Text="Social sources are for super admins" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Social_SuperAdminBody" Text="Ask a super admin to add, run or change a channel’s social sources." Style="{StaticResource ToolsBody}" />
                </StackPanel>
            </Border>

            <!-- The environment's server is from before social sources: the page says so, and Refresh checks again -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.NotOnServer, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Social_NotOnServerTitle" Text="Social sources aren’t on this server yet" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Social_NotOnServerBody" Text="This environment runs an earlier release. Social sources appear here once it is updated." Style="{StaticResource ToolsBody}" />
                    <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind ViewModel.SpinnerMovesHere}" Value="100" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock x:Uid="Social_Refresh" Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 1. The channel: its sources, or every channel's -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.ShowPage, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Social_ChannelTitle" Text="Channel" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Social_ChannelBody" Text="Choose a channel to see and add its sources, or leave it empty to see every channel’s sources." Style="{StaticResource ToolsBody}" />
                    <AutoSuggestBox x:Name="ChannelBox" x:Uid="Social_ChannelBox" PlaceholderText="Search channels"
                                    ItemsSource="{x:Bind ViewModel.Channels}" TextChanged="ChannelBox_TextChanged"
                                    SuggestionChosen="ChannelBox_SuggestionChosen" GotFocus="ChannelBox_GotFocus" QueryIcon="Find">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ImportChannel">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind OwnerEmail}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <TextBlock Text="{x:Bind ViewModel.ChannelError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                               Visibility="{x:Bind ViewModel.ChannelError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    <Border Style="{StaticResource ToolsInsetCard}" Visibility="{x:Bind ViewModel.HasChannel, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource FanousAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SelectedChannel.Name, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                <TextBlock x:Name="ChannelSummaryText" Text="{x:Bind ViewModel.ChannelSummary, Mode=OneWay}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                           Visibility="{x:Bind ViewModel.ChannelSummary, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" Style="{StaticResource ToolsLinkButton}" Padding="8,4" VerticalAlignment="Center" Click="ShowAll_Click">
                                <TextBlock x:Uid="Social_ShowAllChannels" Text="Every channel" />
                            </HyperlinkButton>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. The sources -->
            <Border x:Name="SourcesCard" Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.ShowPage, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Social_SourcesTitle" Text="Sources" Style="{StaticResource ToolsCardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.SourcesSummary, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.SourcesSummary, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind ViewModel.SpinnerMovesHere}" Value="100" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock x:Uid="Social_Refresh" Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.ListError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                               TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasListError, Mode=OneWay}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowNoSources, Mode=OneWay}">
                        <TextBlock x:Uid="Social_NoSourcesTitle" Text="No sources yet" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.NoSourcesBody, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceRow">
                                <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The state at a glance: tick (on), spinner (syncing), arrows (trying again), warning (failed), pause (off) -->
                                        <Grid Width="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource FanousSuccessTextBrush}" Visibility="{x:Bind IsOk, Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind SpinnerMoves}" Value="100" IsActive="{x:Bind IsSyncing, Mode=OneWay}" Visibility="{x:Bind IsSyncing, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsRetrying, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource FanousErrorTextBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE769;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsOff, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE769;" FontSize="16" Foreground="{ThemeResource FanousErrorTextBrush}" Visibility="{x:Bind IsOffNotConnected, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <shell:RightToLeftText Text="{x:Bind Label, Mode=OneWay}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind NetworkLine, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ChannelLine, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasChannelLine, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind AuthLine, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind StatusTip, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                                       TextWrapping="Wrap" Visibility="{x:Bind HasDetail, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind LastSync, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind LastSyncTip, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Counts, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasCounts, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" Visibility="{x:Bind CanChangeSchedule, Mode=OneWay}">
                                                <TextBlock x:Uid="Social_ScheduleLabel" Text="Schedule" Style="{StaticResource ToolsLabel}" VerticalAlignment="Center" />
                                                <ComboBox MinWidth="170" ItemsSource="{x:Bind ScheduleChoices}" SelectedIndex="{x:Bind ScheduleIndex, Mode=OneWay}"
                                                          IsEnabled="{x:Bind IsIdle, Mode=OneWay}" Tag="{x:Bind}" SelectionChanged="Schedule_Changed" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ActionError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                                       TextWrapping="Wrap" Visibility="{x:Bind HasActionError, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,2,0,0">
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Sync_Click" Visibility="{x:Bind CanSync, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_SyncNow" Text="Sync now" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Job_Click" Visibility="{x:Bind HasJob, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_JobLink" Text="Sync job" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="CancelJob_Click" Visibility="{x:Bind CanCancelJob, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_CancelSync" Text="Cancel sync" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Items_Click">
                                                    <TextBlock x:Uid="Social_ItemsLink" Text="Items" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Takeout_Click" Visibility="{x:Bind IsYouTube, Mode=OneWay}">
                                                    <TextBlock x:Uid="Takeout_Link" Text="Takeout files" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="TurnOff_Click" Visibility="{x:Bind CanTurnOff, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_TurnOff" Text="Turn off" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="TurnOn_Click" Visibility="{x:Bind CanTurnOn, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_TurnOn" Text="Turn on" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Remove_Click" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                    <TextBlock x:Uid="Social_Remove" Text="Remove" />
                                                </HyperlinkButton>
                                            </StackPanel>

                                            <!-- The sync job: state, attempts, next try, reason, log; Try again once it gave up -->
                                            <Border Style="{StaticResource ToolsInsetCard}" Tag="JobCard" Visibility="{x:Bind ShowJob, Mode=OneWay}" Margin="0,4,0,0">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{x:Bind JobStatus, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}"
                                                               TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind JobStatusTip, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind JobDetail, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                                               TextWrapping="Wrap" Visibility="{x:Bind HasJobDetail, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                                    <ItemsControl ItemsSource="{x:Bind JobEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LogEntry">
                                                                <Grid ColumnSpacing="12" Padding="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource ToolsMuted}" ToolTipService.ToolTip="{x:Bind Utc}" />
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Lines}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <TextBlock Text="{x:Bind}" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Style="{StaticResource ToolsPrimaryButton}" Tag="{x:Bind}" Click="RetryJob_Click" Visibility="{x:Bind CanRetryJob, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                                                <TextBlock x:Uid="Social_RetryJob" Text="Retry" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolsSecondaryButton}" Tag="{x:Bind}" Click="CancelJob_Click" Visibility="{x:Bind CanCancelJob, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                                <TextBlock x:Uid="Social_CancelJob" Text="Cancel sync" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolsSecondaryButton}" Tag="{x:Bind}" Click="CopyJob_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                                <TextBlock x:Uid="Social_CopyLog" Text="Copy log" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock x:Uid="Social_Copied" Text="Copied" Style="{StaticResource ToolsMuted}" VerticalAlignment="Center" Visibility="{x:Bind JobCopied, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- The latest items: what each became, and why one was skipped or waits -->
                                            <Border Style="{StaticResource ToolsInsetCard}" Visibility="{x:Bind ShowItems, Mode=OneWay}" Margin="0,4,0,0">
                                                <StackPanel Spacing="8">
                                                    <TextBlock x:Uid="Social_ItemsTitle" Text="Latest items" Style="{StaticResource ToolsLabel}" />
                                                    <TextBlock Text="{x:Bind ItemsMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasItemsMessage, Mode=OneWay}" />
                                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SourceItemRow">
                                                                <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasNote}" />
                                                                        <TextBlock Text="{x:Bind When}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasWhen}" />
                                                                        <TextBlock Text="{x:Bind Original}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" TextAlignment="{x:Bind OriginalAlignment}"
                                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Visibility="{x:Bind HasOriginal}" ToolTipService.ToolTip="{x:Bind Original}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- YouTube Takeout files: choose the export's folder, the server matches each video to a record waiting
                                                 for its file, the admin picks the record of an ambiguous one, then the matched files are uploaded -->
                                            <Border Style="{StaticResource ToolsInsetCard}" Tag="TakeoutCard" Visibility="{x:Bind ShowTakeout, Mode=OneWay}" Margin="0,4,0,0">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Uid="Takeout_Title" Text="YouTube Takeout files" Style="{StaticResource ToolsLabel}" />
                                                    <TextBlock x:Uid="Takeout_Body" Text="YouTube does not let us download videos, so each one comes from the owner’s Google Takeout export. Choose the export’s folder: the server matches each video to one waiting here, by its video id, else its title and length." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Style="{StaticResource ToolsSecondaryButton}" Tag="{x:Bind}" Click="ChooseTakeout_Click" IsEnabled="{x:Bind TakeoutIdle, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                                <TextBlock x:Uid="Takeout_Choose" Text="Choose Takeout folder" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolsPrimaryButton}" Tag="{x:Bind}" Click="UploadTakeout_Click" Visibility="{x:Bind CanUploadTakeout, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                                                <TextBlock x:Uid="Takeout_Upload" Text="Upload matched files" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind UploadTakeoutHint, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasUploadTakeoutHint, Mode=OneWay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind HasTakeoutMessage, Mode=OneWay}">
                                                        <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind SpinnerMoves}" Value="100" IsActive="{x:Bind HasTakeoutMessage, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind TakeoutMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind TakeoutError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                                               TextWrapping="Wrap" Visibility="{x:Bind HasTakeoutError, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                                    <Grid ColumnSpacing="8" Visibility="{x:Bind HasTakeoutJob, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind TakeoutJobStatus, Mode=OneWay}" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <HyperlinkButton Grid.Column="1" Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="CancelTakeout_Click" Visibility="{x:Bind TakeoutJobActive, Mode=OneWay}">
                                                            <TextBlock x:Uid="Takeout_CancelJob" Text="Cancel matching" />
                                                        </HyperlinkButton>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind TakeoutSummary, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasTakeoutSummary, Mode=OneWay}" />
                                                    <ItemsControl ItemsSource="{x:Bind TakeoutFiles}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:TakeoutFileRow">
                                                                <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                                                    <StackPanel Spacing="2">
                                                                        <shell:RightToLeftText Text="{x:Bind DisplayName}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                                                        <StackPanel Spacing="2" Visibility="{x:Bind HasMatch}">
                                                                            <TextBlock x:Uid="Takeout_RecordLabel" Text="Matches:" Style="{StaticResource ToolsMuted}" />
                                                                            <shell:RightToLeftText Text="{x:Bind Match}" TextStyle="{StaticResource ToolsMuted}" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasNote, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind Progress, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasProgress, Mode=OneWay}" />
                                                                        <TextBlock Text="{x:Bind Error, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasError, Mode=OneWay}" />
                                                                        <StackPanel Spacing="6" Margin="0,6,0,0" Visibility="{x:Bind IsAmbiguous}">
                                                                            <TextBlock x:Uid="Takeout_PickRecord" Text="Which video is it?" Style="{StaticResource ToolsLabel}" />
                                                                            <ItemsControl ItemsSource="{x:Bind Candidates}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:TakeoutCandidateRow">
                                                                                        <Grid ColumnSpacing="12" Padding="0,4">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*" />
                                                                                                <ColumnDefinition Width="Auto" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <StackPanel Spacing="2">
                                                                                                <shell:RightToLeftText Text="{x:Bind Title}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                                                                                <TextBlock Text="{x:Bind When}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind HasWhen}" />
                                                                                                <TextBlock Text="{x:Bind Original}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Stretch" TextAlignment="{x:Bind OriginalAlignment}"
                                                                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Visibility="{x:Bind HasOriginal}" />
                                                                                            </StackPanel>
                                                                                            <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" VerticalAlignment="Center" Tag="{x:Bind}" Click="PickCandidate_Click" IsEnabled="{x:Bind File.IsIdle, Mode=OneWay}">
                                                                                                <TextBlock x:Uid="Takeout_ThisOne" Text="This one" />
                                                                                            </Button>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Adding a source: from the owner's connected accounts, or with their recorded permission -->
            <Border x:Name="AddCard" Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.ShowPage, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Social_AddTitle" Text="Add a source" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Social_AddBody" Text="Imports go only into a channel whose owner allowed it: an account they connected in Studio, or their written permission, recorded here. Each new post on the source becomes a post on the channel." Style="{StaticResource ToolsBody}" />
                    <TextBlock x:Uid="Social_PickChannelFirst" Text="Choose a channel above first." Style="{StaticResource ToolsMuted}" Visibility="{x:Bind ViewModel.ShowPickChannel, Mode=OneWay}" />

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowAddForm, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="NewScheduleLabel" x:Uid="Social_ScheduleNewLabel" Text="How often to sync" Style="{StaticResource ToolsLabel}" />
                            <ComboBox x:Name="NewScheduleBox" MinWidth="220" AutomationProperties.LabeledBy="{Binding ElementName=NewScheduleLabel}" ItemsSource="{x:Bind ViewModel.ScheduleChoices}" SelectedIndex="{x:Bind ViewModel.ScheduleIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- The owner's own connections: added without a recorded permission -->
                        <Border Style="{StaticResource ToolsInsetCard}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="Social_ConnectionsTitle" Text="Accounts the owner connected" Style="{StaticResource ToolsLabel}" />
                                <TextBlock x:Uid="Social_NoConnections" Text="The owner hasn’t connected an account in Studio. Add a source with their written permission below." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.ShowNoConnections, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Connections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConnectionRow">
                                            <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <shell:RightToLeftText Text="{x:Bind Label}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind NetworkLine}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" VerticalAlignment="Center" Tag="{x:Bind}" Click="AddConnection_Click" Visibility="{x:Bind CanAdd, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                            <TextBlock x:Uid="Social_AddConnection" Text="Add" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" x:Uid="Social_ConnectionAdded" Text="Added" Style="{StaticResource ToolsMuted}" VerticalAlignment="Center" Visibility="{x:Bind IsAdded, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Any other feed or account: its address, and the owner's written permission -->
                        <Border Style="{StaticResource ToolsInsetCard}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Uid="Social_OtherTitle" Text="Another feed or account" Style="{StaticResource ToolsLabel}" />
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="NetworkLabel" x:Uid="Social_NetworkLabel" Text="Where" Style="{StaticResource ToolsLabel}" />
                                    <ComboBox x:Name="NetworkBox" MinWidth="260" ItemsSource="{x:Bind ViewModel.NetworkChoices}" SelectedIndex="{x:Bind ViewModel.NetworkIndex, Mode=TwoWay}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=NetworkLabel}" />
                                </StackPanel>
                                <TextBlock x:Uid="Social_TelegramNote" Text="A Telegram channel is added from the owner’s connection above, once they connect it in Studio: our bot reads its posts." Style="{StaticResource ToolsMuted}"
                                           Foreground="{ThemeResource FanousAccentBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowTelegramNote, Mode=OneWay}" />
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowAddressBox, Mode=OneWay}">
                                    <TextBlock x:Name="AddressLabel" x:Uid="Social_AddressLabel" Text="Address" Style="{StaticResource ToolsLabel}" />
                                    <!-- Addresses read left to right in both languages -->
                                    <TextBox x:Name="AddressBox" TextChanged="ValueBox_TextChanged" FlowDirection="LeftToRight" Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.AddressHint, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowAddressBox, Mode=OneWay}">
                                    <TextBlock x:Name="LabelLabel" x:Uid="Social_LabelLabel" Text="Name in the list (optional)" Style="{StaticResource ToolsLabel}" />
                                    <TextBox x:Name="LabelBox" TextChanged="ValueBox_TextChanged" Text="{x:Bind ViewModel.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=LabelLabel}" />
                                </StackPanel>
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowPermission, Mode=OneWay}">
                                    <TextBlock x:Uid="Social_PermissionTitle" Text="The owner’s permission" Style="{StaticResource ToolsLabel}" />
                                    <TextBlock x:Uid="Social_PermissionBody" Text="Unless the owner connected this account, record whose written permission you have and what they agreed to. It is saved with the source and in the audit log." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ByLabel" x:Uid="Social_PermissionByLabel" Text="Who gave permission" Style="{StaticResource ToolsLabel}" />
                                    <TextBox x:Name="ByBox" TextChanged="ValueBox_TextChanged" Text="{x:Bind ViewModel.PermissionBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=ByLabel}" />
                                    <TextBlock x:Name="NoteLabel" x:Uid="Social_PermissionNoteLabel" Text="How they gave it, and what they agreed to" Style="{StaticResource ToolsLabel}" />
                                    <TextBox x:Name="NoteBox" TextChanged="ValueBox_TextChanged" Text="{x:Bind ViewModel.PermissionNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                             AutomationProperties.LabeledBy="{Binding ElementName=NoteLabel}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.FormError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                           TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasFormError, Mode=OneWay}" />
                                <Button x:Name="AddButton" Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.AddCommand}" Visibility="{x:Bind ViewModel.ShowAddressBox, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind ViewModel.SpinnerMovesHere}" Value="100" IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE710;" FontSize="14" Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <TextBlock x:Uid="Social_AddButton" Text="Add source" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.FormMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousSuccessTextBrush}"
                                   TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasFormMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
