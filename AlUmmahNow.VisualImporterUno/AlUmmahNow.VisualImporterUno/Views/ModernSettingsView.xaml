<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ModernSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporterUno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid Padding="50,0">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Ellipse Width="40" Height="40" Fill="#16A34A"/>
                    <TextBlock Text="Al Ummah Now" FontSize="20" Foreground="#1F2937" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <Grid Padding="40,40,40,40" MaxWidth="1400">
                <StackPanel Spacing="32">
                    <!-- Page Title -->
                    <TextBlock Text="Settings" FontSize="32" Foreground="#111827" FontWeight="Bold"/>

                    <!-- Settings Card -->
                    <Border Background="White" CornerRadius="12" Padding="40">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <StackPanel Spacing="32">
                            <!-- General Section -->
                            <StackPanel>
                                <TextBlock Text="General" FontSize="20" Foreground="#111827" FontWeight="SemiBold" Margin="0,0,0,20"/>

                                <TextBlock Text="Application Name" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Text="Al Ummah Now Tools"
                                         Height="50"
                                         Background="#F9FAFB"
                                         BorderBrush="#D1D5DB"
                                         BorderThickness="1"
                                         CornerRadius="6"
                                         Padding="16,0"
                                         FontSize="15"/>
                            </StackPanel>

                            <!-- Storage Settings Section -->
                            <StackPanel>
                                <TextBlock Text="Storage Settings" FontSize="20" Foreground="#111827" FontWeight="SemiBold" Margin="0,0,0,20"/>

                                <!-- Bunny CDN URL -->
                                <TextBlock Text="Bunny CDN URL" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Text="https://storage.bunnycdn.com/alummahnow"
                                         Height="50"
                                         Background="#F9FAFB"
                                         BorderBrush="#D1D5DB"
                                         BorderThickness="1"
                                         CornerRadius="6"
                                         Padding="16,0"
                                         FontSize="15"
                                         Margin="0,0,0,20"/>

                                <!-- API Key -->
                                <TextBlock Text="API Key" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                                <PasswordBox PlaceholderText="Enter your API key"
                                             Height="50"
                                             Background="#F9FAFB"
                                             BorderBrush="#D1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="6"
                                             Padding="16,0"
                                             FontSize="15"
                                             Margin="0,0,0,20"/>

                                <!-- Test Connection Button -->
                                <Button Content="Test Connection"
                                        Height="50"
                                        MinWidth="200"
                                        Background="White"
                                        Foreground="#374151"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        FontSize="15"
                                        Margin="0,0,0,32"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Save Changes"
                                        Height="50"
                                        MinWidth="180"
                                        Background="#16A34A"
                                        Foreground="White"
                                        CornerRadius="6"
                                        FontSize="15"
                                        FontWeight="SemiBold"/>

                                <Button Content="Cancel"
                                        Height="50"
                                        MinWidth="120"
                                        Background="White"
                                        Foreground="#374151"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="2"
                                        CornerRadius="6"
                                        FontSize="15"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
