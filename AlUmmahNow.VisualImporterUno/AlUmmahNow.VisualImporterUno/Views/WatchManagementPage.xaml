<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.WatchManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AlUmmahNow.VisualImporterUno.Helpers"
    xmlns:models="using:AlUmmahNow.Data.Models.FileScanning"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:LocFormatConverter x:Key="LocFormat"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">
            <shell:ScannerOfflineCard x:Name="OfflineCard" Connected="OfflineCard_Connected" />

            <StackPanel Spacing="16" Visibility="{x:Bind OfflineCard.IsConnected, Mode=OneWay}">

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.OpenCreateWatchDialogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Watch_Add" Text="Watch a folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.OpenBatchCreateDialogCommand}">
                    <TextBlock x:Uid="Watch_AddMany" Text="Watch several" />
                </Button>
                <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshWatchesCommand}" x:Name="RefreshButton">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />

            <!-- Numbers -->
            <shell:TileGrid MinItemWidth="200" MaxColumns="4" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Watch_StatFolders" Text="Watched folders" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalWatchesText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Watch_StatActive" Text="Being watched now" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveWatchesText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Watch_StatFiles" Text="Videos arrived" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.FilesDetectedText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Watch_StatPending" Text="Waiting for approval" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingApprovalsText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                        <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Click="Approvals_Click" Visibility="{x:Bind ViewModel.HasPendingApprovals, Mode=OneWay}">
                            <TextBlock x:Uid="Watch_Review" Text="Review them" />
                        </HyperlinkButton>
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Add one folder -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.IsCreateDialogOpen, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Watch_AddTitle" Text="Watch a folder" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Watch_AddBody" Text="New videos that land in the folder wait for your approval, then upload to the channel." Style="{StaticResource ToolsMuted}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="NewWatchChannelLabel" x:Uid="Watch_ChannelLabel" Text="Channel" Style="{StaticResource ToolsLabel}" />
                        <AutoSuggestBox x:Uid="Watch_ChannelBox" PlaceholderText="Type a channel name"
                                        Text="{x:Bind ViewModel.NewWatchChannelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        helpers:AutoSuggest.Candidates="{x:Bind ViewModel.KnownChannelNames, Mode=OneWay}"
                                        AutomationProperties.LabeledBy="{Binding ElementName=NewWatchChannelLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ChannelNameValidationMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                   Visibility="{x:Bind ViewModel.ChannelNameValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Watch_FolderLabel" Text="Folder" Style="{StaticResource ToolsLabel}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.NewWatchPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="BrowseFolder_Click">
                                <TextBlock x:Uid="Watch_Choose" Text="Choose" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.WatchPathValidationMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                   Visibility="{x:Bind ViewModel.WatchPathValidationMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <CheckBox x:Uid="Watch_Subfolders" Content="Include folders inside it" IsChecked="{x:Bind ViewModel.IncludeSubdirectories, Mode=TwoWay}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Watch_DelayLabel" Text="Wait before picking up a new video" Style="{StaticResource ToolsLabel}" />
                        <Slider Value="{x:Bind ViewModel.ProcessingDelaySeconds, Mode=TwoWay}" Minimum="1" Maximum="60" StepFrequency="1" />
                        <TextBlock Text="{x:Bind ViewModel.ProcessingDelaySeconds, Mode=OneWay, Converter={StaticResource LocFormat}, ConverterParameter=Watch_DelayValue}" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Watch_ExtensionsLabel" Text="Video file types" Style="{StaticResource ToolsLabel}" />
                        <TextBox Text="{x:Bind ViewModel.SelectedExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CreateWatchError, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousErrorTextBrush}"
                               Visibility="{x:Bind ViewModel.CreateWatchError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.CreateWatchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsCreatingWatch, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsCreatingWatch, Mode=OneWay}" />
                                <TextBlock x:Uid="Watch_Start" Text="Start watching" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.CloseCreateWatchDialogCommand}">
                            <TextBlock x:Uid="Watch_Cancel" Text="Cancel" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Add several folders -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.IsBatchCreateDialogOpen, Mode=OneWay}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Watch_ManyTitle" Text="Watch several folders" Style="{StaticResource ToolsCardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton x:Uid="Watch_TabTemplate" Content="From a template" IsChecked="{x:Bind ViewModel.IsTemplateTab, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.ShowBatchTabCommand}" CommandParameter="template" />
                        <ToggleButton x:Uid="Watch_TabFile" Content="From a file" IsChecked="{x:Bind ViewModel.IsFileTab, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.ShowBatchTabCommand}" CommandParameter="file" />
                    </StackPanel>

                    <!-- From a template -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsTemplateTab, Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Watch_TemplateLabel" Text="Template" Style="{StaticResource ToolsLabel}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.SavedTemplates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" MaxWidth="460" />
                        </StackPanel>
                        <shell:TileGrid MinItemWidth="180" MaxColumns="3" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Watch_CountLabel" Text="How many folders" Style="{StaticResource ToolsLabel}" />
                                <NumberBox Value="{x:Bind ViewModel.NumberOfWatches, Mode=TwoWay}" Minimum="1" Maximum="50" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Watch_FirstLabel" Text="First number" Style="{StaticResource ToolsLabel}" />
                                <NumberBox Value="{x:Bind ViewModel.StartingNumber, Mode=TwoWay}" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Watch_BaseLabel" Text="Parent folder" Style="{StaticResource ToolsLabel}" />
                                <TextBox Text="{x:Bind ViewModel.BatchBasePath, Mode=TwoWay}" FlowDirection="LeftToRight" />
                            </StackPanel>
                        </shell:TileGrid>
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.GeneratePreviewCommand}">
                            <TextBlock x:Uid="Watch_Preview" Text="Show the folders" />
                        </Button>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewWatches, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CreateWatchRequest">
                                    <StackPanel Spacing="2" Padding="0,8" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                        <shell:PathText Path="{x:Bind WatchPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ProgressBar Value="{x:Bind ViewModel.BatchCreateProgress, Mode=OneWay}" Maximum="{x:Bind ViewModel.BatchCreateTotal, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsCreatingBatch, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.BatchCreateError, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                   Visibility="{x:Bind ViewModel.BatchCreateError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.CreateWatchesFromTemplateCommand}">
                            <TextBlock x:Uid="Watch_StartAll" Text="Start watching all" />
                        </Button>
                    </StackPanel>

                    <!-- From a file -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsFileTab, Mode=OneWay}">
                        <TextBlock x:Uid="Watch_FileBody" Text="A CSV or JSON file with one row per folder: the channel name and the folder." Style="{StaticResource ToolsMuted}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.ImportFilePath, Mode=TwoWay}" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="BrowseImportFile_Click">
                                <TextBlock x:Uid="Watch_ChooseFile" Text="Choose file" />
                            </Button>
                        </Grid>
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.ImportWatchesFromFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />
                                <TextBlock x:Uid="Watch_CheckFile" Text="Check the file" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.ImportProblemsText, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                   Visibility="{x:Bind ViewModel.HasImportProblems, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ImportError, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                   Visibility="{x:Bind ViewModel.ImportError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.CreateImportedWatchesCommand}">
                            <TextBlock x:Uid="Watch_StartValid" Text="Start watching the valid rows" />
                        </Button>
                    </StackPanel>

                    <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.CloseBatchCreateDialogCommand}">
                        <TextBlock x:Uid="Watch_Close" Text="Close" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- The folders -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Watch_ListTitle" Text="Folders" Style="{StaticResource ToolsCardTitle}" />
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasWatches, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock x:Uid="Watch_EmptyTitle" Text="No folders are watched yet" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                        <TextBlock x:Uid="Watch_EmptyBody" Text="Watch a folder and every new video in it is offered for upload to its channel. The folder scanner has to be on." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveWatches, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WatchStatusDto">
                                <Grid ColumnSpacing="12" Padding="0,12" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Top" Margin="0,6,0,0">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource FanousSuccessTextBrush}" Visibility="{x:Bind IsActive}" />
                                        <Ellipse Width="10" Height="10" Stroke="{ThemeResource FanousTextMutedBrush}" StrokeThickness="1.5" Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsCardTitle}" FontSize="15" />
                                        <shell:PathText Path="{x:Bind WatchPath}" />
                                        <TextBlock Text="{x:Bind TotalFilesDetected, Converter={StaticResource LocFormat}, ConverterParameter=Watch_RowVideos}" Style="{StaticResource ToolsMuted}" />
                                        <TextBlock Text="{x:Bind PendingApprovals, Converter={StaticResource LocFormat}, ConverterParameter=Watch_RowWaiting}" Style="{StaticResource ToolsMuted}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource ToolsSecondaryButton}" VerticalAlignment="Center" Tag="{x:Bind}" Click="StopWatch_Click" Visibility="{x:Bind IsActive}">
                                        <TextBlock x:Uid="Watch_Stop" Text="Stop watching" />
                                    </Button>
                                    <TextBlock Grid.Column="2" x:Uid="Watch_Stopped" Text="Not being watched" Style="{StaticResource ToolsMuted}" VerticalAlignment="Center"
                                               Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
