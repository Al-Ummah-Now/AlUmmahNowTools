<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ServiceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:ColorConverter x:Key="ColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">

            <!-- State and the one action that moves it forward -->
            <Border Style="{StaticResource ToolsCard}">
                <Grid ColumnSpacing="16" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{x:Bind ViewModel.ScannerStatusColor, Mode=OneWay, Converter={StaticResource ColorConverter}}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{x:Bind ViewModel.ScannerTitle, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" FontSize="18" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ScannerDetail, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ScannerActionCommand}" IsEnabled="{x:Bind ViewModel.CanRunScannerAction, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowScannerAction, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsScannerBusy, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsScannerBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{x:Bind ViewModel.ScannerActionText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckButton" Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshStatusCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock x:Uid="Scanner_CheckAgain" Text="Check again" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The scanner process -->
            <shell:TileGrid MinItemWidth="170" MaxColumns="5" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Scanner_ConnectionLabel" Text="Connection" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Scanner_UptimeLabel" Text="Running for" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Scanner_MemoryLabel" Text="Memory" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Scanner_ThreadsLabel" Text="Threads" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ThreadsText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Scanner_ProcessLabel" Text="Process number" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ProcessText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Scans running now -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Scanner_RunningTitle" Text="Scans running" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Scanner_NoScans" Text="No scans are running. Start an import or add a watched folder to scan." Style="{StaticResource ToolsBody}"
                               Visibility="{x:Bind ViewModel.HasActiveOperation, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OngoingOperations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OperationInfo">
                                <Border Style="{StaticResource ToolsInsetCard}" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ToolsCardTitle}" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource ToolsLabel}" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                                        <TextBlock Grid.Row="2" Text="{x:Bind ItemsText, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind StartedText}" Style="{StaticResource ToolsMuted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Activity, newest first -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Scanner_ActivityTitle" Text="Activity" Style="{StaticResource ToolsCardTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="Clear_Click"
                                Visibility="{x:Bind ViewModel.HasActivity, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock x:Uid="Scanner_ClearActivity" Text="Clear" />
                        </Button>
                    </Grid>
                    <TextBlock x:Uid="Scanner_NoActivity" Text="Nothing yet. Turning the scanner on, scans and problems are listed here." Style="{StaticResource ToolsBody}"
                               Visibility="{x:Bind ViewModel.HasActivity, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityEntry">
                                <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{x:Bind GlyphColor, Converter={StaticResource ColorConverter}}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ToolsMuted}" Visibility="{x:Bind HasDetail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource ToolsMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
