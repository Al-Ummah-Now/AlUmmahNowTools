<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:core="using:AlUmmahNow.ToolsCore.Import"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" SizeChanged="Page_SizeChanged" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Spacing="16" Padding="24,8,24,24" MaxWidth="1200">

            <!-- 1. The channel the videos go to -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Import_ChannelTitle" Text="Channel" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Import_ChannelBody" Text="Every video in this import goes to one channel. Find it by name or handle, or make a new one." Style="{StaticResource ToolsBody}" />
                    <Grid x:Name="ChannelRow" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox x:Name="ChannelBox" x:Uid="Import_ChannelBox" PlaceholderText="Search channels"
                                        ItemsSource="{x:Bind ViewModel.Channels}" TextChanged="ChannelBox_TextChanged"
                                        SuggestionChosen="ChannelBox_SuggestionChosen" GotFocus="ChannelBox_GotFocus" QueryIcon="Find">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="core:ImportChannel">
                                    <StackPanel Padding="0,6" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind OwnerEmail}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <Button x:Name="NewChannelButton" Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="NewChannel_Click" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Uid="Import_NewChannel" Text="New channel" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.ChannelError, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                               Visibility="{x:Bind ViewModel.ChannelError, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

                    <!-- The chosen channel, so it is never in doubt where the videos go -->
                    <Border Style="{StaticResource ToolsInsetCard}" Visibility="{x:Bind ViewModel.HasChannel, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource FanousAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SelectedChannel.Name, Mode=OneWay}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ChannelSummary, Mode=OneWay}" Style="{StaticResource ToolsMuted}"
                                           Visibility="{x:Bind ViewModel.ChannelSummary, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. The folder -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Import_FolderTitle" Text="Folder" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Import_FolderBody" Text="Tools finds the videos in it and the caption, chapter, thumbnail and metadata files next to them." Style="{StaticResource ToolsBody}" />
                    <Grid x:Name="FolderRow" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Paths read left to right in both languages; the empty field's placeholder follows the language (FolderBox_TextChanged) -->
                        <TextBox x:Name="FolderBox" x:Uid="Import_FolderBox" PlaceholderText="No folder chosen yet" FlowDirection="LeftToRight" TextChanged="FolderBox_TextChanged" Loaded="FolderBox_TextChanged"
                                 Text="{x:Bind ViewModel.FolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="BrowseFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock x:Uid="Import_Browse" Text="Choose folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <CheckBox x:Uid="Import_Subfolders" Content="Include folders inside it" IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="CaptionLanguageLabel" x:Uid="Import_CaptionLanguageLabel" Text="Captions without a language in the name are in" Style="{StaticResource ToolsLabel}" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.CaptionLanguageIndex, Mode=TwoWay}" MinWidth="220"
                                  AutomationProperties.LabeledBy="{Binding ElementName=CaptionLanguageLabel}">
                            <ComboBoxItem x:Uid="Import_CaptionLanguageAsk" Content="Leave them out" />
                            <ComboBoxItem x:Uid="Import_CaptionLanguageAr" Content="Arabic" />
                            <ComboBoxItem x:Uid="Import_CaptionLanguageEn" Content="English" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ScanCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind ViewModel.SpinnerMovesHere}" Value="100" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE721;" FontSize="14" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock x:Uid="Import_Scan" Text="Find videos" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}"
                               Visibility="{x:Bind ViewModel.ScanMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Before anything is found or queued: what comes next -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.ShowEmptyReview, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Import_EmptyTitle" Text="Videos show here" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Import_EmptyBody" Text="Choose a channel and a folder, then find its videos. You pick which ones to import; nothing uploads until you add them to the queue." Style="{StaticResource ToolsBody}" />
                </StackPanel>
            </Border>

            <!-- 3. What the scan found -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.HasReview, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Import_FoundTitle" Text="Videos found" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.ReviewSummary, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,0,0,0">
                        <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Command="{x:Bind ViewModel.SelectAllCommand}">
                            <TextBlock x:Uid="Import_SelectAll" Text="Select all" />
                        </HyperlinkButton>
                        <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Command="{x:Bind ViewModel.SelectNoneCommand}">
                            <TextBlock x:Uid="Import_SelectNone" Text="Select none" />
                        </HyperlinkButton>
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewRow">
                                <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Title}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <shell:RightToLeftText Text="{x:Bind Title}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                            <shell:RightToLeftText Visibility="{x:Bind HasOtherTitle}" Text="{x:Bind OtherTitle}" TextStyle="{StaticResource ToolsBody}" />
                                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FileName}" />
                                            <TextBlock Text="{x:Bind Sidecars}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Notes}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasNotes}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Size}" Style="{StaticResource ToolsMuted}" TextWrapping="NoWrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Encoding: on this computer unless the server is asked to (TA-12) -->
                    <Border Style="{StaticResource ToolsInsetCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Import_EncodeTitle" Text="Encoding" Style="{StaticResource ToolsLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.EncodeBody, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                            <CheckBox x:Uid="Import_EncodeServer" Content="Let the server encode these videos" IsChecked="{x:Bind ViewModel.ServerEncodesShown, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChooseEncode, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.EncodeNote, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}"
                                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasEncodeNote, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <!-- Speech to text: on this computer, Quran as verse references, translated by the server (TA-13) -->
                    <Border Style="{StaticResource ToolsInsetCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Import_TranscribeTitle" Text="Speech to text and translation" Style="{StaticResource ToolsLabel}" />
                            <TextBlock x:Uid="Import_TranscribeBody" Text="Tools writes down what is said in each video." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                            <CheckBox x:Uid="Import_TranscribeHere" Content="Transcribe the videos that have no captions" IsChecked="{x:Bind ViewModel.TranscribeHere, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanTranscribe, Mode=OneWay}" />
                            <TextBlock x:Uid="Import_TranscribeUnavailable" Text="This copy of Tools can't transcribe." Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}"
                                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.CannotTranscribe, Mode=OneWay}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.TranscribeHere, Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="SpokenLanguageLabel" x:Uid="Import_SpokenLanguageLabel" Text="What they speak" Style="{StaticResource ToolsLabel}" />
                                    <ComboBox SelectedIndex="{x:Bind ViewModel.SpokenLanguageIndex, Mode=TwoWay}" MinWidth="220"
                                              AutomationProperties.LabeledBy="{Binding ElementName=SpokenLanguageLabel}">
                                        <ComboBoxItem x:Uid="Import_SpokenLanguageDetect" Content="Find out from each video" />
                                        <ComboBoxItem x:Uid="Import_SpokenLanguageAr" Content="Arabic" />
                                        <ComboBoxItem x:Uid="Import_SpokenLanguageEn" Content="English" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="SpeechModelLabel" x:Uid="Import_SpeechModelLabel" Text="Speech model" Style="{StaticResource ToolsLabel}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.ModelChoices}" SelectedIndex="{x:Bind ViewModel.ModelIndex, Mode=TwoWay}" MinWidth="220"
                                              AutomationProperties.LabeledBy="{Binding ElementName=SpeechModelLabel}" />
                                    <TextBlock Text="{x:Bind ViewModel.ModelStatus, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.DeviceText, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Uid="Import_TranslateCaptions" Content="Ask the server to translate the captions into the site’s other language" IsChecked="{x:Bind ViewModel.TranslateCaptions, Mode=TwoWay}" />
                            <TextBlock x:Uid="Import_TranslateNote" Text="Each translation is a machine-made draft." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.TranslateCaptions, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.AddToQueueCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind ViewModel.SpinnerMovesHere}" Value="100" IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE898;" FontSize="14" Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.AddButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Uid="Import_PickChannelFirst" Text="Choose a channel above first." Style="{StaticResource ToolsMuted}"
                               Visibility="{x:Bind ViewModel.HasChannel, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 4. The work queue: survives restarts, retries on its own -->
            <Border x:Name="QueueCard" Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Import_QueueTitle" Text="Queue" Style="{StaticResource ToolsCardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <shell:WrapRow x:Name="QueueActions" Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.PauseAllCommand}"
                                    Visibility="{x:Bind ViewModel.CanPauseAll, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                                    <TextBlock x:Uid="Import_PauseAll" Text="Pause all" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ResumeAllCommand}" Visibility="{x:Bind ViewModel.CanResumeAll, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock x:Uid="Import_ResumeAll" Text="Resume all" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveAllButton" Style="{StaticResource ToolsSecondaryButton}" Click="RemoveAll_Click"
                                    IsEnabled="{x:Bind ViewModel.HasQueue, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Uid="Import_RemoveAll" Text="Remove all" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.ClearFinishedCommand}" Visibility="{x:Bind ViewModel.HasFinished, Mode=OneWay}">
                                <TextBlock x:Uid="Import_ClearFinished" Text="Clear finished" />
                            </Button>
                        </shell:WrapRow>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.QueueRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueRow">
                                <Border BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The state at a glance: tick, warning, clock (waiting), arrows (trying again), cloud (the server is working), pause or spinner -->
                                        <Grid Width="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource FanousSuccessTextBrush}" Visibility="{x:Bind IsDone, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource FanousErrorTextBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsWaiting, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsServerWorking, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsRetrying, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE769;" FontSize="16" Foreground="{ThemeResource FanousTextSecondaryBrush}" Visibility="{x:Bind IsPaused, Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16" IsIndeterminate="{x:Bind SpinnerMoves}" Value="100" IsActive="{x:Bind ShowProgress, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <shell:RightToLeftText Text="{x:Bind Title}" TextStyle="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" ToolTipService.ToolTip="{x:Bind FileName}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind StatusTip, Mode=OneWay}" />
                                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ShowProgress, Mode=OneWay}" Margin="0,4" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousErrorTextBrush}"
                                                       TextWrapping="Wrap" Visibility="{x:Bind HasDetail, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind ShowNote, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousAccentBrush}"
                                                       TextWrapping="Wrap" Visibility="{x:Bind ShowProblemNote, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind TranscriptNote, Mode=OneWay}" Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" Visibility="{x:Bind ShowTranscriptNote, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="-8,2,0,0">
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Pause_Click" Visibility="{x:Bind CanPause, Mode=OneWay}">
                                                    <TextBlock x:Uid="Import_RowPause" Text="Pause" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Resume_Click" Visibility="{x:Bind CanResume, Mode=OneWay}">
                                                    <TextBlock x:Uid="Import_RowResume" Text="Resume" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Retry_Click" Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                                    <TextBlock x:Uid="Import_RowRetry" Text="Try again now" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Log_Click">
                                                    <TextBlock x:Uid="Import_RowLog" Text="Log" />
                                                </HyperlinkButton>
                                                <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Remove_Click">
                                                    <TextBlock x:Uid="Import_RowRemove" Text="Remove" />
                                                </HyperlinkButton>
                                            </StackPanel>
                                            <!-- The log, opened under the row: what happened, when, and the reference to quote -->
                                            <Border Style="{StaticResource ToolsInsetCard}" Visibility="{x:Bind ShowLog, Mode=OneWay}" Margin="0,4,0,0">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ToolsMuted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                                    <ItemsControl ItemsSource="{x:Bind LogEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:LogEntry">
                                                                <Grid ColumnSpacing="12" Padding="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource ToolsMuted}" ToolTipService.ToolTip="{x:Bind Utc}" />
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Lines}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <TextBlock Text="{x:Bind}" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Style="{StaticResource ToolsSecondaryButton}" Tag="{x:Bind}" Click="CopyLog_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                                <TextBlock x:Uid="Import_LogCopyButton" Text="Copy log" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock x:Uid="Import_LogCopiedNote" Text="Copied" Style="{StaticResource ToolsMuted}" VerticalAlignment="Center" Visibility="{x:Bind LogCopied, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- How much runs at once -->
                    <Border Style="{StaticResource ToolsInsetCard}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="Import_ParallelTitle" Text="At the same time" Style="{StaticResource ToolsLabel}" />
                            <TextBlock x:Uid="Import_ParallelBody" Text="More at once is faster on a fast computer and connection. Encodes go up to 4 and uploads up to 5." Style="{StaticResource ToolsMuted}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="8" x:Name="ParallelGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="HashBox" x:Uid="Import_ParallelHash" Header="Checking files" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ParallelChoices}" SelectedIndex="{x:Bind ViewModel.HashParallel, Mode=TwoWay}" />
                                <ComboBox x:Name="EncodeBox" Grid.Column="1" x:Uid="Import_ParallelEncode" Header="Encodes" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.EncodeChoices}" SelectedIndex="{x:Bind ViewModel.EncodeParallel, Mode=TwoWay}" />
                                <ComboBox x:Name="UploadBox" Grid.Row="1" x:Uid="Import_ParallelUpload" Header="Uploads" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.UploadChoices}" SelectedIndex="{x:Bind ViewModel.UploadParallel, Mode=TwoWay}" />
                                <ComboBox x:Name="AttachBox" Grid.Row="1" Grid.Column="1" x:Uid="Import_ParallelAttach" Header="Captions and extras" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ParallelChoices}" SelectedIndex="{x:Bind ViewModel.AttachParallel, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
