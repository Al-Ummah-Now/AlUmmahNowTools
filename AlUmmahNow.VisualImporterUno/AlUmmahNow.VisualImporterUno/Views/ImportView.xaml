<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AlUmmahNow.VisualImporterUno.Models"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">

            <!-- 1. The folder -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Import_FolderTitle" Text="Folder" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Import_FolderBody" Text="Each folder inside it becomes a channel. Tools finds the videos and the caption, chapter and thumbnail files next to them." Style="{StaticResource ToolsBody}" />
                    <!-- Paths read left to right in both languages -->
                    <TextBox x:Uid="Import_FolderBox" PlaceholderText="No folder chosen yet" FlowDirection="LeftToRight"
                             Text="{x:Bind ViewModel.SelectedFolderPath, Mode=OneWay}" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.SelectFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock x:Uid="Import_Browse" Text="Choose folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ScanFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock x:Uid="Import_Scan" Text="Find videos" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- What happened last, with the reason on its own line when something failed -->
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Before a scan: what comes next -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="Import_EmptyTitle" Text="Videos show here" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Import_EmptyBody" Text="Choose a folder and find its videos. You then pick which ones to upload; nothing uploads until you say so." Style="{StaticResource ToolsBody}" />
                </StackPanel>
            </Border>

            <!-- 2. The videos found -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.HasScannedFiles, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Import_FoundTitle" Text="Videos found" Style="{StaticResource ToolsCardTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.FileStatistics.TotalSizeFormatted, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind ViewModel.SelectedFileCountText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" HorizontalTextAlignment="Right" />
                            <TextBlock x:Uid="Import_SelectedLabel" Text="selected" Style="{StaticResource ToolsMuted}" HorizontalTextAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.SelectAllFilesCommand}">
                            <TextBlock x:Uid="Import_SelectAll" Text="Select all" />
                        </Button>
                        <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.DeselectAllFilesCommand}">
                            <TextBlock x:Uid="Import_SelectNone" Text="Select none" />
                        </Button>
                    </StackPanel>
                    <CheckBox x:Uid="Import_OnlySelected" Content="Show only selected" IsChecked="{x:Bind ViewModel.ShowOnlySelected, Mode=TwoWay}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredVideoFiles, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoFileInfo">
                                <Grid ColumnSpacing="12" Padding="0,10" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FileSizeFormatted}" Style="{StaticResource ToolsMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource ToolsPrimaryButton}" HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.StartImportCommand}" IsEnabled="{x:Bind ViewModel.HasSelectedFiles, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock x:Uid="Import_Upload" Text="Upload selected" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
