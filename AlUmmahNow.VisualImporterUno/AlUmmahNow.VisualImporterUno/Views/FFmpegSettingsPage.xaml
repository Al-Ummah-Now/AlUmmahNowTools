<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.FFmpegSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="FFmpeg Configuration"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,24"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <!-- Status Section -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Installation Status"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- Status Message -->
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Version Info -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay}">
                            <TextBlock Text="FFmpeg Version" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.FFmpegVersion, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Auto-detect Button -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Auto-Detect FFmpeg"
                                    Click="AutoDetectButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay}"
                                          Width="20"
                                          Height="20"/>
                        </StackPanel>

                        <InfoBar
                            Severity="Informational"
                            IsOpen="True"
                            IsClosable="False"
                            Message="FFmpeg is required for video thumbnail generation and metadata extraction. Click 'Auto-Detect' to find it automatically or specify paths manually below."
                            Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Manual Configuration -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Manual Configuration"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <!-- FFmpeg Path -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="FFmpeg Executable Path" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="FFmpegPathTextBox"
                                         Text="{x:Bind ViewModel.FFmpegPath, Mode=TwoWay}"
                                         PlaceholderText="C:\ffmpeg\bin\ffmpeg.exe"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Click="BrowseFFmpegButton_Click"/>
                            </Grid>
                            <TextBlock Text="Full path to the ffmpeg executable file"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- FFprobe Path -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="FFprobe Executable Path" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="FFprobePathTextBox"
                                         Text="{x:Bind ViewModel.FFprobePath, Mode=TwoWay}"
                                         PlaceholderText="C:\ffmpeg\bin\ffprobe.exe"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Click="BrowseFFprobeButton_Click"/>
                            </Grid>
                            <TextBlock Text="Full path to the ffprobe executable file"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Save Paths"
                                    Click="SavePathsButton_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button Content="Verify Installation"
                                    Click="VerifyButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsVerifying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsVerifying, Mode=OneWay}"
                                          Width="20"
                                          Height="20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Installation Instructions -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Installation Instructions"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <TextBlock Text="{x:Bind ViewModel.InstallationInstructions, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <HyperlinkButton Content="Visit FFmpeg Official Website"
                                         NavigateUri="https://ffmpeg.org/download.html"
                                         HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Video Processing Features -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Features Enabled by FFmpeg"
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Thumbnail Generation -->
                            <FontIcon Grid.Row="0" Grid.Column="0"
                                      Glyph="&#xE91B;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      Margin="0,0,12,12"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Video Thumbnail Generation"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Generate preview thumbnails from video files automatically"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Metadata Extraction -->
                            <FontIcon Grid.Row="1" Grid.Column="0"
                                      Glyph="&#xE8BC;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      Margin="0,0,12,12"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Video Metadata Extraction"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Extract duration, resolution, codec, and bitrate information"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Format Detection -->
                            <FontIcon Grid.Row="2" Grid.Column="0"
                                      Glyph="&#xE8F1;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      Margin="0,0,12,12"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Format Detection"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically detect video formats and properties"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>

                            <!-- Quality Analysis -->
                            <FontIcon Grid.Row="3" Grid.Column="0"
                                      Glyph="&#xE9D9;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      Margin="0,0,12,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock Text="Quality Analysis"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Analyze video quality metrics and technical details"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
