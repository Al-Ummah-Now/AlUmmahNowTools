<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.FFmpegSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">

            <!-- State -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9F5;" FontSize="18" />
                        <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" FontSize="18" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Style="{StaticResource ToolsPrimaryButton}" Click="AutoDetectButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsAutoDetecting, Mode=OneWay}" />
                                <TextBlock x:Uid="Video_Detect" Text="Find automatically" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolsSecondaryButton}" Click="VerifyButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsVerifying, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsVerifying, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsVerifying, Mode=OneWay}" />
                                <TextBlock x:Uid="Video_Verify" Text="Check again" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- What they do -->
            <shell:TileGrid MinItemWidth="220" MaxColumns="3" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE91B;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource FanousAccentBrush}" />
                        <TextBlock x:Uid="Video_UseThumbsTitle" Text="Thumbnails" Style="{StaticResource ToolsCardTitle}" FontSize="15" />
                        <TextBlock x:Uid="Video_UseThumbsBody" Text="A thumbnail from the video when the folder has none." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8BC;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource FanousAccentBrush}" />
                        <TextBlock x:Uid="Video_UseDetailsTitle" Text="Video details" Style="{StaticResource ToolsCardTitle}" FontSize="15" />
                        <TextBlock x:Uid="Video_UseDetailsBody" Text="Length, picture size and format, read before upload." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8F1;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource FanousAccentBrush}" />
                        <TextBlock x:Uid="Video_UseChecksTitle" Text="File checks" Style="{StaticResource ToolsCardTitle}" FontSize="15" />
                        <TextBlock x:Uid="Video_UseChecksBody" Text="Broken or unplayable files are caught before they upload." Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Where they are -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="Video_LocationsTitle" Text="Program locations" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Video_LocationsBody" Text="Found automatically in most cases. Set them yourself only if the programs are somewhere unusual." Style="{StaticResource ToolsMuted}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Video_ConverterLabel" Text="Video converter (ffmpeg)" Style="{StaticResource ToolsLabel}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.FFmpegPath, Mode=TwoWay}" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="BrowseFFmpegButton_Click">
                                <TextBlock x:Uid="Video_Browse" Text="Choose" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Video_ReaderLabel" Text="Video reader (ffprobe)" Style="{StaticResource ToolsLabel}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.FFprobePath, Mode=TwoWay}" FlowDirection="LeftToRight" />
                            <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Click="BrowseFFprobeButton_Click">
                                <TextBlock x:Uid="Video_Browse2" Text="Choose" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Button Style="{StaticResource ToolsPrimaryButton}" Click="SavePathsButton_Click">
                        <TextBlock x:Uid="Video_Save" Text="Save locations" />
                    </Button>
                    <TextBlock x:Name="SaveStatus" Style="{StaticResource ToolsMuted}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Installing them -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Video_InstallTitle" Text="Installing them" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Video_InstallBody" Text="Both programs come in one free package. Run this in a terminal, then choose Find automatically." Style="{StaticResource ToolsBody}" />
                    <Border Style="{StaticResource ToolsInsetCard}">
                        <TextBlock Text="{x:Bind ViewModel.InstallationInstructions, Mode=OneWay}" FlowDirection="LeftToRight" IsTextSelectionEnabled="True"
                                   FontFamily="Menlo, Consolas, monospace" FontSize="13" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                    </Border>
                    <HyperlinkButton Style="{StaticResource ToolsLinkButton}" NavigateUri="https://ffmpeg.org/download.html">
                        <TextBlock x:Uid="Video_Website" Text="Other ways to install" />
                    </HyperlinkButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
