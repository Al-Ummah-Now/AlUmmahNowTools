<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.AnalyticsDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:ColorConverter x:Key="ColorConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">
            <shell:ScannerOfflineCard x:Name="OfflineCard" Connected="OfflineCard_Connected" />

            <StackPanel Spacing="16" Visibility="{x:Bind OfflineCard.IsConnected, Mode=OneWay}">

            <!-- Period and actions -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleButton x:Uid="Stats_Today" Content="Today" IsChecked="{x:Bind ViewModel.IsToday, Mode=OneWay}" Command="{x:Bind ViewModel.ChangePeriodCommand}" CommandParameter="{x:Bind vm:TimePeriod.Today}" />
                    <ToggleButton x:Uid="Stats_Week" Content="This week" IsChecked="{x:Bind ViewModel.IsThisWeek, Mode=OneWay}" Command="{x:Bind ViewModel.ChangePeriodCommand}" CommandParameter="{x:Bind vm:TimePeriod.ThisWeek}" />
                    <ToggleButton x:Uid="Stats_Month" Content="This month" IsChecked="{x:Bind ViewModel.IsThisMonth, Mode=OneWay}" Command="{x:Bind ViewModel.ChangePeriodCommand}" CommandParameter="{x:Bind vm:TimePeriod.ThisMonth}" />
                    <ToggleButton x:Uid="Stats_All" Content="All time" IsChecked="{x:Bind ViewModel.IsAllTime, Mode=OneWay}" Command="{x:Bind ViewModel.ChangePeriodCommand}" CommandParameter="{x:Bind vm:TimePeriod.AllTime}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshAnalyticsCommand}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.ExportReportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Uid="Stats_Export" Text="Save as CSV" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Headline numbers -->
            <shell:TileGrid MinItemWidth="200" MaxColumns="3" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Approved" Text="Approved" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalApprovalsText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                        <TextBlock Text="{x:Bind ViewModel.ApprovalTrendText, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Rate" Text="Approved out of all decided and waiting" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ApprovalRateText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Waiting" Text="Waiting now" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.FilesPendingText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Oldest" Text="Oldest waiting for" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.AvgApprovalTimeText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Size" Text="Approved size" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSizeApprovedText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Stats_Busiest" Text="Busiest channel" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.MostActiveChannel, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" FontSize="20" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Arrivals per day -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Stats_DailyTitle" Text="Videos that arrived, by day" Style="{StaticResource ToolsCardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{ThemeResource FanousAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Stats_LegendApproved" Text="Approved" Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{ThemeResource FanousTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Stats_LegendRejected" Text="Rejected" Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" BorderThickness="1" BorderBrush="{ThemeResource FanousAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Stats_LegendWaiting" Text="Waiting" Style="{StaticResource ToolsMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ApprovalTrends, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DailyTrendData">
                                    <StackPanel Spacing="6" Width="54">
                                        <Grid Height="140" ColumnSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Height="{x:Bind ApprovedHeight}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Background="{ThemeResource FanousAccentBrush}" />
                                            <Border Grid.Column="1" Height="{x:Bind RejectedHeight}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" Background="{ThemeResource FanousTextMutedBrush}" />
                                            <Border Grid.Column="2" Height="{x:Bind PendingHeight}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0" BorderThickness="1,1,1,0" BorderBrush="{ThemeResource FanousAccentBrush}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind DateLabel}" Style="{StaticResource ToolsMuted}" FontSize="11" HorizontalTextAlignment="Center" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <shell:TileGrid MinItemWidth="340" MaxColumns="2" Spacing="16">
                <!-- Top channels -->
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="Stats_TopTitle" Text="Top channels" Style="{StaticResource ToolsCardTitle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopChannels, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChannelStatistic">
                                    <StackPanel Spacing="6" Padding="0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ApprovalRateText}" Style="{StaticResource ToolsBody}" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind ApprovalRate}" Maximum="100" />
                                        <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource ToolsMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Priorities -->
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="Stats_PriorityTitle" Text="By priority" Style="{StaticResource ToolsCardTitle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PriorityStats, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PriorityDistribution">
                                    <StackPanel Spacing="6" Padding="0,8">
                                        <TextBlock Text="{x:Bind PriorityLabel}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                        <ProgressBar Value="{x:Bind Percentage}" Maximum="100" />
                                        <TextBlock Text="{x:Bind CountText}" Style="{StaticResource ToolsMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Busy hours -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Stats_HoursTitle" Text="When videos arrive, by hour" Style="{StaticResource ToolsCardTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PeakHours, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <shell:TileGrid MinItemWidth="40" MaxColumns="12" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HourlyActivity">
                                <Grid Height="52" CornerRadius="6">
                                    <Border Background="{ThemeResource FanousAccentBrush}" Opacity="{x:Bind Intensity}" CornerRadius="6" />
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{x:Bind HourLabel}" Style="{StaticResource ToolsMuted}" Foreground="{ThemeResource FanousTextPrimaryBrush}" Opacity="0.8" FontSize="11" HorizontalTextAlignment="Center" />
                                        <TextBlock Text="{x:Bind FileCountText}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" HorizontalTextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Latest -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Stats_RecentTitle" Text="Latest videos" Style="{StaticResource ToolsCardTitle}" />
                    <TextBlock x:Uid="Stats_RecentEmpty" Text="Nothing has arrived yet in this period." Style="{StaticResource ToolsMuted}"
                               Visibility="{x:Bind ViewModel.HasRecentActivity, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivities, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentActivityItem">
                                <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsMuted}" />
                                        <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource ToolsMuted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" Style="{StaticResource ToolsBody}" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind StatusColor, Converter={StaticResource ColorConverter}}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
