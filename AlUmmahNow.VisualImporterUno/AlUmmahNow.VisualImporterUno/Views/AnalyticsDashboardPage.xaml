<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.AnalyticsDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporterUno.Views"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8F9FA">

    <Page.Resources>
        <!-- Card Styles -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style x:Key="ActivePeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="White" Padding="40,32">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Analytics Dashboard" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   FontSize="16" Foreground="#6B7280" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Period Selector -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Today"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Command="{x:Bind ViewModel.ChangePeriodCommand}"
                                    CommandParameter="{x:Bind vm:TimePeriod.Today}"/>
                            <Button Content="This Week"
                                    Style="{StaticResource ActivePeriodButtonStyle}"
                                    Command="{x:Bind ViewModel.ChangePeriodCommand}"
                                    CommandParameter="{x:Bind vm:TimePeriod.ThisWeek}"/>
                            <Button Content="This Month"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Command="{x:Bind ViewModel.ChangePeriodCommand}"
                                    CommandParameter="{x:Bind vm:TimePeriod.ThisMonth}"/>
                            <Button Content="All Time"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Command="{x:Bind ViewModel.ChangePeriodCommand}"
                                    CommandParameter="{x:Bind vm:TimePeriod.AllTime}"/>
                        </StackPanel>

                        <Border Width="1" Height="32" Background="#E5E7EB"/>

                        <!-- Action Buttons -->
                        <Button Background="White" Foreground="#374151" Height="40" CornerRadius="6"
                                BorderBrush="#E5E7EB" BorderThickness="1" Padding="16,0"
                                Command="{x:Bind ViewModel.RefreshAnalyticsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" Foreground="#374151"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Background="#16A34A" Foreground="White" Height="40" CornerRadius="6" Padding="16,0"
                                Command="{x:Bind ViewModel.ExportReportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Download" Foreground="White"/>
                                <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Key Statistics Overview -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Approvals Card -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#DCFCE7" CornerRadius="6">
                                    <SymbolIcon Symbol="Accept" Foreground="#16A34A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Total Approvals" Style="{StaticResource CardTitleStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.TotalApprovals, Mode=OneWay}" Style="{StaticResource StatNumberStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.ApprovalTrend, Mode=OneWay, Converter={StaticResource TrendConverter}}"
                                          FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                          Foreground="{x:Bind ViewModel.ApprovalTrend, Mode=OneWay, Converter={StaticResource TrendColorConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Approval Rate Card -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#DBEAFE" CornerRadius="6">
                                    <SymbolIcon Symbol="Accept" Foreground="#3B82F6"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Approval Rate" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock FontSize="36" FontWeight="Bold" Foreground="#111827">
                                <Run Text="{x:Bind ViewModel.ApprovalRate, Mode=OneWay, Converter={StaticResource DoubleToStringConverter}}"/>
                                <Run Text="%" FontSize="24"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Average Approval Time Card -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#FEF3C7" CornerRadius="6">
                                    <SymbolIcon Symbol="Clock" Foreground="#F59E0B"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Avg Approval Time" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock FontSize="36" FontWeight="Bold" Foreground="#111827">
                                <Run Text="{x:Bind ViewModel.AvgApprovalTimeHours, Mode=OneWay, Converter={StaticResource DoubleToStringConverter}}"/>
                                <Run Text="h" FontSize="20"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Files Pending Card -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#FEE2E2" CornerRadius="6">
                                    <SymbolIcon Symbol="More" Foreground="#EF4444"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Files Pending" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.FilesPending, Mode=OneWay}" Style="{StaticResource StatNumberStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Size Approved Card -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#E0E7FF" CornerRadius="6">
                                    <SymbolIcon Symbol="Upload" Foreground="#6366F1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Total Size Approved" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalSizeApproved, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"
                                      FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <!-- Most Active Channel Card -->
                    <Border Grid.Column="5" Style="{StaticResource StatCardStyle}" Margin="12,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Border Width="40" Height="40" Background="#F3E8FF" CornerRadius="6">
                                    <SymbolIcon Symbol="Globe" Foreground="#A855F7"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Most Active Channel" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.MostActiveChannel, Mode=OneWay}"
                                      FontSize="20" FontWeight="SemiBold" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <Grid Padding="40,24,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Charts Row -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Approval Trends Chart -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Approval Trends" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- Chart Area -->
                            <Grid Height="250">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Trend Bars -->
                                <ItemsControl Grid.Row="0" ItemsSource="{x:Bind ViewModel.ApprovalTrends, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DailyTrendData">
                                            <StackPanel Width="40" Height="230" VerticalAlignment="Bottom">
                                                <!-- Approved Bar -->
                                                <Border Background="#16A34A" CornerRadius="4,4,0,0" Margin="0,0,0,1"
                                                       Height="{x:Bind ApprovedPercentage, Converter={StaticResource PercentageHeightConverter}}"/>
                                                <!-- Rejected Bar -->
                                                <Border Background="#EF4444" CornerRadius="0,0,4,4"
                                                       Height="{x:Bind RejectedPercentage, Converter={StaticResource PercentageHeightConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- X-Axis Labels -->
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.ApprovalTrends, Mode=OneWay}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DailyTrendData">
                                            <TextBlock Text="{x:Bind DateLabel}" Width="40" FontSize="11" Foreground="#6B7280"
                                                      TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" Background="#16A34A" CornerRadius="2"/>
                                    <TextBlock Text="Approved" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" Background="#EF4444" CornerRadius="2"/>
                                    <TextBlock Text="Rejected" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Priority Distribution -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Priority Distribution" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- Priority Rings -->
                            <Grid Height="200" Margin="0,0,0,20">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PriorityStats, Mode=OneWay}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PriorityDistribution">
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8">
                                                <ProgressBar Value="{x:Bind Percentage}" Maximum="100" Width="120" Height="20"
                                                           Foreground="{x:Bind Color}" CornerRadius="4"/>
                                                <StackPanel Width="100">
                                                    <TextBlock Text="{x:Bind PriorityLabel}" FontSize="13" Foreground="#111827" FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="12" Foreground="#6B7280">
                                                        <Run Text="{x:Bind Count}"/>
                                                        <Run Text="files"/>
                                                        <Run Text="("/>
                                                        <Run Text="{x:Bind Percentage, Converter={StaticResource DoubleToStringConverter}}"/>
                                                        <Run Text="%)"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Second Charts Row -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Channels -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Top 5 Channels" Style="{StaticResource SectionTitleStyle}"/>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopChannels, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChannelStatistic">
                                        <Border Padding="0,12" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Channel Name and Count -->
                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind ChannelName}" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
                                                        <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,4,0,0">
                                                            <Run Text="{x:Bind TotalFiles}"/>
                                                            <Run Text="files •"/>
                                                            <Run Text="{x:Bind TotalSizeFormatted}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ApprovalRate, Converter={StaticResource DoubleToStringConverter}}"
                                                             FontSize="18" FontWeight="Bold" Foreground="#16A34A"
                                                             HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Progress Bar -->
                                                <Grid Grid.Row="1" Height="8">
                                                    <Border Background="#F3F4F6" CornerRadius="4"/>
                                                    <Border Background="#16A34A" CornerRadius="4" HorizontalAlignment="Left"
                                                           Width="{x:Bind ApprovalRate, Converter={StaticResource PercentageWidthConverter}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Peak Hours Heatmap -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Peak Hours (24h)" Style="{StaticResource SectionTitleStyle}"/>

                            <!-- Heatmap Grid -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PeakHours, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HourlyActivity">
                                        <Border Width="60" Height="50" Margin="4"
                                               Background="{x:Bind IntensityColor}" CornerRadius="6"
                                               ToolTipService.ToolTip="{x:Bind FileCount}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind HourLabel}" FontSize="11" FontWeight="SemiBold"
                                                         Foreground="#111827" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind FileCount}" FontSize="16" FontWeight="Bold"
                                                         Foreground="#111827" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Heatmap Legend -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <TextBlock Text="Low" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <Border Width="20" Height="12" Background="#86EFAC" CornerRadius="2"/>
                                <Border Width="20" Height="12" Background="#FCD34D" CornerRadius="2"/>
                                <Border Width="20" Height="12" Background="#F59E0B" CornerRadius="2"/>
                                <Border Width="20" Height="12" Background="#DC2626" CornerRadius="2"/>
                                <TextBlock Text="High" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent Activity -->
                <Border Grid.Row="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitleStyle}"/>

                        <ListView ItemsSource="{x:Bind ViewModel.RecentActivities, Mode=OneWay}"
                                 SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentActivityItem">
                                    <Border Padding="16,12" Margin="0,0,0,8" Background="#F9FAFB" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind FileName}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                    <TextBlock FontSize="12" Foreground="#6B7280">
                                                        <Run Text="Channel:"/>
                                                        <Run Text="{x:Bind ChannelName}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                    <TextBlock Text="•" FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{x:Bind TimeAgo}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{x:Bind StatusColor}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- Empty State -->
                        <Border Visibility="{x:Bind ViewModel.RecentActivities.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                               Padding="40" Background="#F9FAFB" CornerRadius="6">
                            <TextBlock Text="No recent activity" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#80000000"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60" Foreground="White"/>
                <TextBlock Text="Loading analytics..." FontSize="16" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
