<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:ColorConverter x:Key="ColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- At a glance: the same figures as Watched folders and Approvals -->
            <shell:TileGrid MinItemWidth="190" MaxColumns="4" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Dashboard_WaitingLabel" Text="Waiting for approval" Style="{StaticResource ToolsLabel}" />
                        <TextBlock x:Name="WaitingValue" Text="–" Style="{StaticResource ToolsStatValue}" />
                        <HyperlinkButton x:Name="ReviewLink" Style="{StaticResource ToolsLinkButton}" Padding="0" Click="Approvals_Click" Visibility="Collapsed">
                            <TextBlock x:Uid="Dashboard_Review" Text="Review them" />
                        </HyperlinkButton>
                        <TextBlock x:Name="WaitingHint" x:Uid="Dashboard_WaitingHint" Text="Videos from watched folders" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Dashboard_ArrivedLabel" Text="Videos arrived" Style="{StaticResource ToolsLabel}" />
                        <TextBlock x:Name="ArrivedValue" Text="–" Style="{StaticResource ToolsStatValue}" />
                        <TextBlock x:Uid="Dashboard_ArrivedHint" Text="In watched folders" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Dashboard_WatchingLabel" Text="Folders being watched" Style="{StaticResource ToolsLabel}" />
                        <TextBlock x:Name="WatchingValue" Text="–" Style="{StaticResource ToolsStatValue}" />
                        <TextBlock x:Name="WatchingHint" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Dashboard_ProblemsLabel" Text="Problems" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ProblemCountText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                        <TextBlock x:Uid="Dashboard_ProblemsHint" Text="Each one can be tried again below" Style="{StaticResource ToolsMuted}" />
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <shell:TileGrid MinItemWidth="320" MaxColumns="2" Spacing="16">
                <!-- The folder scanner -->
                <Border Style="{StaticResource ToolsCard}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource FanousBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource FanousPrimaryBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="Dashboard_ScannerHeading" Text="Folder scanner" Style="{StaticResource ToolsLabel}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{x:Bind ViewModel.ScannerStatusColor, Mode=OneWay, Converter={StaticResource ColorConverter}}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{x:Bind ViewModel.ScannerTitle, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScannerDetail, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ScannerActionCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanRunScannerAction, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowScannerAction, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsScannerBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsScannerBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{x:Bind ViewModel.ScannerActionText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton x:Uid="Dashboard_ScannerDetails" Content="Scanner details" Style="{StaticResource ToolsLinkButton}" VerticalAlignment="Center" Click="ScannerDetails_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Imports -->
                <Border Style="{StaticResource ToolsCard}">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource FanousBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{ThemeResource FanousPrimaryBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Uid="Dashboard_ImportHeading" Text="Bulk import" Style="{StaticResource ToolsLabel}" />
                                <TextBlock x:Uid="Dashboard_ImportTitle" Text="Bring a folder of videos to a channel" Style="{StaticResource ToolsCardTitle}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Uid="Dashboard_ImportBody" Text="Pick a folder. Tools finds the videos and their caption, chapter and thumbnail files, then uploads them to the channel you choose, with no upload limits." Style="{StaticResource ToolsBody}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource ToolsPrimaryButton}" Click="StartNewImportButton_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control"/>
                                </Button.KeyboardAccelerators>
                                <TextBlock x:Uid="Dashboard_StartImport" Text="Start new import" />
                            </Button>
                            <HyperlinkButton x:Uid="Dashboard_WatchedFolders" Content="Watched folders" Style="{StaticResource ToolsLinkButton}" VerticalAlignment="Center" Click="WatchedFolders_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </shell:TileGrid>

            <!-- Scans running now -->
            <Border Style="{StaticResource ToolsCard}" Visibility="{x:Bind ViewModel.HasActiveOperation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Dashboard_RunningTitle" Text="Scans running" Style="{StaticResource ToolsCardTitle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.OngoingOperations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OperationInfo">
                                <Border Style="{StaticResource ToolsInsetCard}" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ToolsCardTitle}" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource ToolsLabel}" />
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Problems, each with a way forward -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Dashboard_ProblemsTitle" Text="Problems" Style="{StaticResource ToolsCardTitle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshStatusCommand}">
                                <TextBlock x:Uid="Dashboard_TryAgain" Text="Try again" />
                            </Button>
                            <HyperlinkButton x:Uid="Dashboard_SeeAll" Content="See all" Style="{StaticResource ToolsLinkButton}" VerticalAlignment="Center" Click="ScannerDetails_Click" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource FanousSuccessTextBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock x:Uid="Dashboard_NoProblems" Text="No problems. If a scan or an import goes wrong, it shows here with a way to try again." Style="{StaticResource ToolsBody}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityEntry">
                                <Border Style="{StaticResource ToolsInsetCard}" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{x:Bind GlyphColor, Converter={StaticResource ColorConverter}}" />
                                            </FontIcon.Foreground>
                                        </FontIcon>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ToolsMuted}" Visibility="{x:Bind HasDetail}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource ToolsMuted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
