<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ApprovalWorkflowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AlUmmahNow.VisualImporterUno.Helpers"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:models="using:AlUmmahNow.Data.Models.FileScanning"
    xmlns:dataModels="using:AlUmmahNow.Data.Models"
    xmlns:shell="using:AlUmmahNow.VisualImporterUno.Shell"
    xmlns:local="using:AlUmmahNow.VisualImporterUno.Views"
    xmlns:converters="using:AlUmmahNow.VisualImporterUno.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:LocFormatConverter x:Key="LocFormat"/>
        <converters:ColorConverter x:Key="ColorConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:StringToLongConverter x:Key="StringToLong"/>
        <local:DateTimeToDateConverter x:Key="DateTimeToDate"/>
        <local:PathToUriConverter x:Key="PathToUri"/>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24,8,24,24" MaxWidth="1200">
            <shell:ScannerOfflineCard x:Name="OfflineCard" Connected="OfflineCard_Connected" />

            <StackPanel Spacing="16" Visibility="{x:Bind OfflineCard.IsConnected, Mode=OneWay}">

            <!-- Numbers -->
            <shell:TileGrid MinItemWidth="200" MaxColumns="4" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Approve_StatPending" Text="Waiting" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Approve_StatApproved" Text="Approved" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.ApprovedText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Approve_StatRejected" Text="Rejected" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.RejectedText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Approve_StatSize" Text="Size waiting" Style="{StaticResource ToolsLabel}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingSizeText, Mode=OneWay}" Style="{StaticResource ToolsStatValue}" />
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Filters, folded away until wanted -->
            <Border Style="{StaticResource ToolsCard}" Padding="0">
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <Expander.Header>
                        <TextBlock x:Uid="Approve_FiltersTitle" Text="Filters and presets" Style="{StaticResource ToolsCardTitle}" />
                    </Expander.Header>
                    <StackPanel Spacing="16">
                        <shell:TileGrid MinItemWidth="220" MaxColumns="3" Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ChannelFilterLabel" x:Uid="Approve_ChannelLabel" Text="Channel" Style="{StaticResource ToolsLabel}" />
                                <AutoSuggestBox x:Uid="Approve_ChannelBox" PlaceholderText="All channels" QueryIcon="Find"
                                                helpers:AutoSuggest.Candidates="{x:Bind ViewModel.AvailableChannels, Mode=OneWay}"
                                                helpers:AutoSuggest.Value="{x:Bind ViewModel.ChannelFilter, Mode=TwoWay}"
                                                AutomationProperties.LabeledBy="{Binding ElementName=ChannelFilterLabel}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Approve_PriorityLabel" Text="Priority" Style="{StaticResource ToolsLabel}" />
                                <ComboBox x:Uid="Approve_PriorityBox" PlaceholderText="Any priority" SelectedItem="{x:Bind ViewModel.PriorityFilter, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:Int32>1</x:Int32>
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                    <x:Int32>4</x:Int32>
                                    <x:Int32>5</x:Int32>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Approve_TypeLabel" Text="File types" Style="{StaticResource ToolsLabel}" />
                                <TextBox x:Uid="Approve_TypeBox" PlaceholderText="mp4, mkv" FlowDirection="LeftToRight" Text="{x:Bind ViewModel.ExtensionFilter, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Approve_SizeLabel" Text="Size in bytes" Style="{StaticResource ToolsLabel}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Uid="Approve_MinBox" PlaceholderText="From" Text="{x:Bind ViewModel.MinSizeFilter, Mode=TwoWay, Converter={StaticResource StringToLong}}" />
                                    <TextBox Grid.Column="1" x:Uid="Approve_MaxBox" PlaceholderText="To" Text="{x:Bind ViewModel.MaxSizeFilter, Mode=TwoWay, Converter={StaticResource StringToLong}}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Approve_FromLabel" Text="Arrived from" Style="{StaticResource ToolsLabel}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.DateFromFilter, Mode=TwoWay, Converter={StaticResource DateTimeToDate}}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Approve_ToLabel" Text="Arrived until" Style="{StaticResource ToolsLabel}" />
                                <CalendarDatePicker Date="{x:Bind ViewModel.DateToFilter, Mode=TwoWay, Converter={StaticResource DateTimeToDate}}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </shell:TileGrid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.ClearFiltersCommand}">
                                <TextBlock x:Uid="Approve_ClearFilters" Text="Clear filters" />
                            </Button>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource FanousDividerBrush}" />

                        <TextBlock x:Uid="Approve_PresetsTitle" Text="Presets" Style="{StaticResource ToolsLabel}" />
                        <ComboBox x:Uid="Approve_PresetBox" PlaceholderText="Choose a preset" ItemsSource="{x:Bind ViewModel.SavedPresets, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" MaxWidth="460" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedPreset.Description, Mode=OneWay}" Style="{StaticResource ToolsMuted}"
                                   Visibility="{x:Bind ViewModel.SelectedPreset, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.LoadPresetCommand}" CommandParameter="{x:Bind ViewModel.SelectedPreset, Mode=OneWay}">
                                <TextBlock x:Uid="Approve_PresetUse" Text="Use" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Click="OnSavePresetClick">
                                <TextBlock x:Uid="Approve_PresetSave" Text="Save these filters" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.SetDefaultPresetCommand}" CommandParameter="{x:Bind ViewModel.SelectedPreset, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SelectedPreset, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                                <TextBlock x:Uid="Approve_PresetMakeDefault" Text="Make default" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.DeletePresetCommand}" CommandParameter="{x:Bind ViewModel.SelectedPreset, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SelectedPreset, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                                <TextBlock x:Uid="Approve_PresetDelete" Text="Delete" />
                            </Button>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource FanousDividerBrush}" />

                        <TextBlock x:Uid="Approve_AllTitle" Text="Everything that matches the filters" Style="{StaticResource ToolsLabel}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.BulkApproveCommand}">
                                <TextBlock x:Uid="Approve_AllApprove" Text="Approve all" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.BulkRejectCommand}">
                                <TextBlock x:Uid="Approve_AllReject" Text="Reject all" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- The list and the video it is showing -->
            <shell:TileGrid MinItemWidth="420" MaxColumns="2" Spacing="16">
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.ListTitleText, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshApprovalsCommand}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ToolsMuted}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SortBox" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Approve_SortDate" Content="Newest first" />
                                <ComboBoxItem x:Uid="Approve_SortName" Content="By file name" />
                                <ComboBoxItem x:Uid="Approve_SortSize" Content="By size" />
                                <ComboBoxItem x:Uid="Approve_SortPriority" Content="By priority" />
                                <ComboBoxItem x:Uid="Approve_SortChannel" Content="By channel" />
                            </ComboBox>
                            <ToggleButton Grid.Column="1" x:Name="SortDirection" IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}">
                                <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                            </ToggleButton>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource ToolsSecondaryButton}" Click="SelectAll_Click">
                                <TextBlock x:Uid="Approve_SelectAll" Text="Select all" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Click="SelectNone_Click">
                                <TextBlock x:Uid="Approve_SelectNone" Text="Select none" />
                            </Button>
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasApprovals, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock x:Uid="Approve_EmptyTitle" Text="Nothing is waiting" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" />
                            <TextBlock x:Uid="Approve_EmptyBody" Text="Videos that arrive in watched folders wait here for a yes or a no. Clear the filters if you expected some." Style="{StaticResource ToolsMuted}" />
                        </StackPanel>

                        <ListView x:Name="ApprovalsList" SelectionMode="Multiple" ItemsSource="{x:Bind ViewModel.FilteredApprovals, Mode=OneWay}"
                                  SelectionChanged="ApprovalsList_SelectionChanged" MaxHeight="640" Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PendingApprovalDto">
                                    <Grid ColumnSpacing="12" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ToolsBody}" Foreground="{ThemeResource FanousTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind ChannelName}" Style="{StaticResource ToolsMuted}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                <TextBlock Text="·" Style="{StaticResource ToolsMuted}" />
                                                <TextBlock Text="{x:Bind FileSize, Converter={StaticResource LocFormat}, ConverterParameter=Bytes}" Style="{StaticResource ToolsMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                            <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="Preview_Click">
                                                <TextBlock x:Uid="Approve_RowPreview" Text="Preview" />
                                            </HyperlinkButton>
                                            <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="ApproveOne_Click">
                                                <TextBlock x:Uid="Approve_RowApprove" Text="Approve" />
                                            </HyperlinkButton>
                                            <HyperlinkButton Style="{StaticResource ToolsLinkButton}" Padding="8,4" Tag="{x:Bind}" Click="RejectOne_Click">
                                                <TextBlock x:Uid="Approve_RowReject" Text="Reject" />
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ApproveSelectedCommand}">
                                <TextBlock Text="{x:Bind ViewModel.ApproveSelectedText, Mode=OneWay}" />
                            </Button>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RejectSelectedCommand}">
                                <TextBlock Text="{x:Bind ViewModel.RejectSelectedText, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource ToolsCard}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="Approve_PreviewTitle" Text="Preview" Style="{StaticResource ToolsCardTitle}" />
                        <TextBlock x:Uid="Approve_PreviewEmpty" Text="Choose Preview on a video to see its picture and details here." Style="{StaticResource ToolsMuted}"
                                   Visibility="{x:Bind ViewModel.CurrentApproval, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CurrentApproval, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                            <Border Style="{StaticResource ToolsInsetCard}" Padding="0" Height="200">
                                <Grid>
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsGeneratingThumbnail, Mode=OneWay}" Width="32" Height="32" />
                                    <Image Source="{x:Bind ViewModel.CurrentThumbnailPath, Mode=OneWay, Converter={StaticResource PathToUri}}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RefreshThumbnailCommand}">
                                <TextBlock x:Uid="Approve_ThumbAgain" Text="Make the picture again" />
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.CurrentApproval.FileName, Mode=OneWay}" Style="{StaticResource ToolsCardTitle}" FontSize="15" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="Approve_DChannel" Text="Channel" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentApproval.ChannelName, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="1" x:Uid="Approve_DSize" Text="Size" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentSizeText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="2" x:Uid="Approve_DArrived" Text="Arrived" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CurrentDetectedText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="3" x:Uid="Approve_DLength" Text="Length" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="4" x:Uid="Approve_DPicture" Text="Picture size" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="5" x:Uid="Approve_DFrames" Text="Frame rate" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                                <TextBlock Grid.Row="6" x:Uid="Approve_DBitrate" Text="Bit rate" Style="{StaticResource ToolsMuted}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" Style="{StaticResource ToolsBody}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource ToolsPrimaryButton}" Command="{x:Bind ViewModel.ApproveOneCommand}" CommandParameter="{x:Bind ViewModel.CurrentApproval, Mode=OneWay}">
                                    <TextBlock x:Uid="Approve_PApprove" Text="Approve" />
                                </Button>
                                <Button Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.RejectOneCommand}" CommandParameter="{x:Bind ViewModel.CurrentApproval, Mode=OneWay}">
                                    <TextBlock x:Uid="Approve_PReject" Text="Reject" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </shell:TileGrid>

            <!-- Activity -->
            <Border Style="{StaticResource ToolsCard}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Approve_ActivityTitle" Text="Activity" Style="{StaticResource ToolsCardTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ToolsSecondaryButton}" Command="{x:Bind ViewModel.ClearActivityLogCommand}">
                            <TextBlock x:Uid="Approve_ActivityClear" Text="Clear" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ActivityLog, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApprovalLogMessage">
                                <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{ThemeResource FanousDividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{x:Bind GlyphColor, Converter={StaticResource ColorConverter}}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Message}" Style="{StaticResource ToolsBody}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource ToolsMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
