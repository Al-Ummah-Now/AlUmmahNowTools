<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ApprovalWorkflowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporterUno.Views"
    xmlns:vm="using:AlUmmahNow.VisualImporterUno.ViewModels"
    xmlns:models="using:AlUmmahNow.Data.Models.FileScanning"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8F9FA">

    <Page.Resources>
        <!-- Card Styles -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Styles -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <!-- Input Styles -->
        <Style x:Key="FilterInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Data Template for Approval List Items -->
        <DataTemplate x:Key="ApprovalItemTemplate" x:DataType="models:PendingApprovalDto">
            <Border Background="White" Padding="16" Margin="0,0,0,8" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selection Checkbox -->
                    <CheckBox Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- File Information -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Extension}" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{x:Bind Priority, Converter={StaticResource PriorityColorConverter}}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Priority}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                            <TextBlock FontSize="13" Foreground="#6B7280">
                                <Run Text="Channel:"/>
                                <Run Text="{x:Bind ChannelName}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="#6B7280">
                                <Run Text="Size:"/>
                                <Run Text="{x:Bind FileSize, Converter={StaticResource FileSizeConverter}}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock FontSize="13" Foreground="#6B7280">
                                <Run Text="Detected:"/>
                                <Run Text="{x:Bind DetectedAt, Converter={StaticResource RelativeDateConverter}}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Preview" Background="#F3F4F6" Foreground="#374151"
                                CornerRadius="6" Height="36" Padding="16,0" FontSize="13"
                                Command="{Binding DataContext.PreviewFileCommand, ElementName=PageRoot}"
                                CommandParameter="{x:Bind}"/>
                        <Button Content="Approve" Background="#DCFCE7" Foreground="#16A34A"
                                CornerRadius="6" Height="36" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
                        <Button Content="Reject" Background="#FEE2E2" Foreground="#DC2626"
                                CornerRadius="6" Height="36" Padding="16,0" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Activity Log Template -->
        <DataTemplate x:Key="ActivityLogTemplate" x:DataType="vm:ApprovalLogMessage">
            <Border Padding="12,8" Margin="0,0,0,4" Background="#F9FAFB" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{x:Bind TypeIcon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayText}" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="White" Padding="40,32">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and Bulk Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Approval Workflow" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   FontSize="16" Foreground="#6B7280" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.RefreshApprovalsCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" Foreground="#374151"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button Content="Select All"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.SelectAllCommand}"/>

                        <Button Content="Clear Selection"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.DeselectAllCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.ApproveSelectedCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Accept" Foreground="White"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay, Converter={StaticResource ApproveButtonTextConverter}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DangerButtonStyle}"
                                Command="{x:Bind ViewModel.RejectSelectedCommand}"
                                IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Cancel" Foreground="White"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay, Converter={StaticResource RejectButtonTextConverter}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Statistics Dashboard -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pending Card -->
                    <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Ellipse Width="12" Height="12" Fill="#F59E0B"/>
                                <TextBlock Text="Pending" FontSize="13" Foreground="#92400E" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Statistics.PendingCount, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold" Foreground="#92400E"/>
                        </StackPanel>
                    </Border>

                    <!-- Approved Card -->
                    <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="8" Padding="20" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Ellipse Width="12" Height="12" Fill="#16A34A"/>
                                <TextBlock Text="Approved" FontSize="13" Foreground="#14532D" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Statistics.ApprovedCount, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold" Foreground="#14532D"/>
                        </StackPanel>
                    </Border>

                    <!-- Rejected Card -->
                    <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="8" Padding="20" Margin="6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Ellipse Width="12" Height="12" Fill="#DC2626"/>
                                <TextBlock Text="Rejected" FontSize="13" Foreground="#7F1D1D" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Statistics.RejectedCount, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold" Foreground="#7F1D1D"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Size Card -->
                    <Border Grid.Column="3" Background="#DBEAFE" CornerRadius="8" Padding="20" Margin="12,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <Ellipse Width="12" Height="12" Fill="#3B82F6"/>
                                <TextBlock Text="Total Size" FontSize="13" Foreground="#1E3A8A" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Statistics.TotalSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"
                                       FontSize="32" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <Grid Padding="40,24,40,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Filters -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <!-- Filters Header -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <Grid>
                            <TextBlock Text="Filters" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <Button Content="Clear"
                                    Background="Transparent"
                                    Foreground="#EF4444"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.ClearFiltersCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Channel Filter -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Channel" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableChannels, Mode=OneWay}"
                                     SelectedItem="{x:Bind ViewModel.ChannelFilter, Mode=TwoWay}"
                                     Style="{StaticResource FilterComboStyle}"
                                     PlaceholderText="All Channels"/>
                        </StackPanel>
                    </Border>

                    <!-- Priority Filter -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Priority" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            <ComboBox SelectedItem="{x:Bind ViewModel.PriorityFilter, Mode=TwoWay}"
                                     Style="{StaticResource FilterComboStyle}"
                                     PlaceholderText="All Priorities">
                                <x:Int32>1</x:Int32>
                                <x:Int32>2</x:Int32>
                                <x:Int32>3</x:Int32>
                                <x:Int32>4</x:Int32>
                                <x:Int32>5</x:Int32>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- File Size Filter -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="File Size" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{x:Bind ViewModel.MinSizeFilter, Mode=TwoWay, Converter={StaticResource StringToLongConverter}}"
                                    Style="{StaticResource FilterInputStyle}"
                                    PlaceholderText="Min size (bytes)"/>
                            <TextBox Text="{x:Bind ViewModel.MaxSizeFilter, Mode=TwoWay, Converter={StaticResource StringToLongConverter}}"
                                    Style="{StaticResource FilterInputStyle}"
                                    PlaceholderText="Max size (bytes)"/>
                        </StackPanel>
                    </Border>

                    <!-- Date Range Filter -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Date Range" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            <DatePicker Date="{x:Bind ViewModel.DateFromFilter, Mode=TwoWay, Converter={StaticResource DateTimeToDateConverter}}"
                                       Header="From"
                                       HorizontalAlignment="Stretch"/>
                            <DatePicker Date="{x:Bind ViewModel.DateToFilter, Mode=TwoWay, Converter={StaticResource DateTimeToDateConverter}}"
                                       Header="To"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Extension Filter -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="File Extension" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{x:Bind ViewModel.ExtensionFilter, Mode=TwoWay}"
                                    Style="{StaticResource FilterInputStyle}"
                                    PlaceholderText="e.g., mp4, mkv"/>
                            <TextBlock Text="Comma-separated list" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </Border>

                    <!-- Bulk Actions -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Bulk Actions" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                            <TextBlock Text="Apply actions to all files matching current filters"
                                      FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Button Content="Bulk Approve All"
                                    Background="#16A34A"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Height="40"
                                    Command="{x:Bind ViewModel.BulkApproveCommand}"/>

                            <Button Content="Bulk Reject All"
                                    Background="#DC2626"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Height="40"
                                    Command="{x:Bind ViewModel.BulkRejectCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Panel - Approvals List -->
                <StackPanel Grid.Column="1" Margin="8,0">
                    <!-- List Header -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4">
                                    <Run Text="Pending Approvals"/>
                                    <Run Text="(" Foreground="#6B7280"/>
                                    <Run Text="{x:Bind ViewModel.FilteredApprovals.Count, Mode=OneWay}" Foreground="#6B7280"/>
                                    <Run Text=")" Foreground="#6B7280"/>
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay, Converter={StaticResource SelectedCountTextConverter}}"
                                          FontSize="13" Foreground="#6B7280"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <ComboBox SelectedItem="{x:Bind ViewModel.SortBy, Mode=TwoWay}"
                                         Width="150"
                                         Height="36">
                                    <ComboBoxItem Content="Date Detected"/>
                                    <ComboBoxItem Content="File Name" Tag="FileName"/>
                                    <ComboBoxItem Content="File Size" Tag="FileSize"/>
                                    <ComboBoxItem Content="Priority" Tag="Priority"/>
                                    <ComboBoxItem Content="Channel" Tag="ChannelName"/>
                                </ComboBox>

                                <ToggleButton IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                                             Width="36" Height="36"
                                             Background="White"
                                             BorderBrush="#E5E7EB"
                                             BorderThickness="1"
                                             CornerRadius="6">
                                    <SymbolIcon Symbol="Sort"/>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Loading Indicator -->
                    <ProgressBar IsIndeterminate="True"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,16"/>

                    <!-- Approvals List -->
                    <ListView ItemsSource="{x:Bind ViewModel.FilteredApprovals, Mode=OneWay}"
                             ItemTemplate="{StaticResource ApprovalItemTemplate}"
                             SelectionMode="None"
                             IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Empty State -->
                    <Border Visibility="{x:Bind ViewModel.FilteredApprovals.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                            Background="White"
                            Padding="40"
                            CornerRadius="8"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <Ellipse Width="80" Height="80" Fill="#F3F4F6"/>
                            <TextBlock Text="No approvals found"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="#111827"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Try adjusting your filters or check back later"
                                      FontSize="14"
                                      Foreground="#6B7280"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Panel - Preview and Activity -->
                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <!-- File Preview -->
                    <Border Style="{StaticResource FilterCardStyle}"
                            Visibility="{x:Bind ViewModel.CurrentApproval, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="File Preview" Style="{StaticResource SectionTitleStyle}" Margin="0"/>

                            <!-- Thumbnail Placeholder -->
                            <Border Background="#F3F4F6"
                                   Height="180"
                                   CornerRadius="6"
                                   HorizontalAlignment="Stretch">
                                <SymbolIcon Symbol="Video"
                                           Foreground="#9CA3AF"
                                           RenderTransformOrigin="0.5,0.5">
                                    <SymbolIcon.RenderTransform>
                                        <ScaleTransform ScaleX="3" ScaleY="3"/>
                                    </SymbolIcon.RenderTransform>
                                </SymbolIcon>
                            </Border>

                            <!-- File Details -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind ViewModel.CurrentApproval.FileName, Mode=OneWay}"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="#111827"
                                          TextWrapping="Wrap"/>

                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Channel" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentApproval.ChannelName, Mode=OneWay}"
                                                  FontSize="12"
                                                  Foreground="#111827"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Size" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentApproval.FileSize, Mode=OneWay, Converter={StaticResource FileSizeConverter}}"
                                                  FontSize="12"
                                                  Foreground="#111827"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Extension" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentApproval.Extension, Mode=OneWay}"
                                                  FontSize="12"
                                                  Foreground="#111827"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Priority" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentApproval.Priority, Mode=OneWay}"
                                                  FontSize="12"
                                                  Foreground="#111827"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Detected" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentApproval.DetectedAt, Mode=OneWay, Converter={StaticResource DateTimeConverter}}"
                                                  FontSize="12"
                                                  Foreground="#111827"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <Button Content="Approve"
                                            Background="#16A34A"
                                            Foreground="White"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Height="40"/>

                                    <Button Content="Reject"
                                            Background="#DC2626"
                                            Foreground="White"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Height="40"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity Log -->
                    <Border Style="{StaticResource FilterCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="Activity Log" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <Button Content="Clear"
                                       Background="Transparent"
                                       Foreground="#EF4444"
                                       BorderThickness="0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       Command="{x:Bind ViewModel.ClearActivityLogCommand}"/>
                            </Grid>

                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ActivityLog, Mode=OneWay}"
                                            ItemTemplate="{StaticResource ActivityLogTemplate}"/>
                            </ScrollViewer>

                            <!-- Empty Log State -->
                            <Border Visibility="{x:Bind ViewModel.ActivityLog.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}"
                                   Padding="20"
                                   Background="#F9FAFB"
                                   CornerRadius="6">
                                <TextBlock Text="No activity yet"
                                          FontSize="13"
                                          Foreground="#9CA3AF"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
