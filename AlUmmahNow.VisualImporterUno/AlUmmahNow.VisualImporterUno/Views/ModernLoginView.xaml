<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AlUmmahNow.VisualImporterUno.Views.ModernLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AlUmmahNow.VisualImporterUno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Login Card -->
        <Border Width="540" Height="600"
                Background="White"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <StackPanel Padding="50" VerticalAlignment="Center">
                <!-- Logo -->
                <Ellipse Width="80" Height="80" Fill="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Title -->
                <TextBlock Text="Welcome to Al Ummah Now"
                           FontSize="28"
                           Foreground="#111827"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Sign in to manage your Islamic content"
                           FontSize="15"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Email Field -->
                <TextBlock Text="Email" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                <TextBox PlaceholderText="admin@alummahnow.com"
                         Height="50"
                         BorderBrush="#D1D5DB"
                         BorderThickness="2"
                         CornerRadius="6"
                         Padding="16,0"
                         FontSize="15"
                         Margin="0,0,0,20"/>

                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                <PasswordBox PlaceholderText="Enter your password"
                             Height="50"
                             BorderBrush="#D1D5DB"
                             BorderThickness="2"
                             CornerRadius="6"
                             Padding="16,0"
                             FontSize="15"
                             Margin="0,0,0,32"/>

                <!-- Sign In Button -->
                <Button Height="55"
                        HorizontalAlignment="Stretch"
                        CornerRadius="8">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#15803D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="Sign In" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                </Button>

                <!-- Forgot Password Link -->
                <HyperlinkButton Content="Forgot password?"
                                 FontSize="14"
                                 Foreground="#16A34A"
                                 HorizontalAlignment="Center"
                                 Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
