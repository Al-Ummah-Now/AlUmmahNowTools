<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AlUmmahNow.VisualImporterUno.Shell.ScannerOfflineCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource ToolsCard}">
        <Grid ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource FanousDividerBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="&#xE895;" FontSize="20" Foreground="{ThemeResource FanousAccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="Offline_Title" Text="The folder scanner is off" Style="{StaticResource ToolsCardTitle}" />
                <TextBlock x:Name="Detail" Style="{StaticResource ToolsBody}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource ToolsPrimaryButton}" Click="OpenScanner_Click">
                    <TextBlock x:Uid="Offline_Open" Text="Open Folder scanner" />
                </Button>
                <Button x:Name="RetryButton" Style="{StaticResource ToolsSecondaryButton}" Click="Retry_Click">
                    <TextBlock x:Uid="Offline_Retry" Text="Check again" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
